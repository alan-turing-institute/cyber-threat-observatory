{"id": "CVE-2026-82452", "identity": {"title": "CVE-2026-82452", "published": "2026-08-29 13:47:54", "modified": "2026-08-29 14:16:38", "description": "rust-iot-platform through commit 5df942ab contains an authentication bypass vulnerability where most REST API routes lack authentication guards in their handler signatures. Unauthenticated attackers can create, update, list, retrieve, and delete user accounts by directly accessing unprotected endpoints without providing valid credentials."}, "cvss": {"base_score": 9.8, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/iot-ecology/rust-iot-platform/blob/5df942ab6bc46a3bf83dbee8c7970554f92c972d/api/src/controller/user_router.rs"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-306"], "cwe_primary": "CWE-306", "cwe_family": null, "cwe_names": {"CWE-306": "Missing Authentication for Critical Function"}}, "software": {"vendors": "iot-ecology", "products": "rust-iot-platform", "cpe_uris": "cpe:2.3:a:iot-ecology:rust-iot-platform:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/iot-ecology/rust-iot-platform/blob/5df942ab6bc46a3bf83dbee8c7970554f92c972d/api/src/controller/user_router.rs", "https://github.com/iot-ecology/rust-iot-platform", "https://www.vulncheck.com/advisories/rust-iot-platform-authentication-bypass-via-missing-request-guards"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82452", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82452"}, "item_id": "CVE-2026-82452", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "1", "reason": "Unauthenticated authentication bypass allowing full user account manipulation, matching identity/access weakness and public-facing enterprise flaw criteria.", "fail_open": false}}
{"id": "CVE-2026-82450", "identity": {"title": "CVE-2026-82450", "published": "2026-08-29 13:47:53", "modified": "2026-08-29 14:16:37", "description": "BookStack before 26.05.4 contains a remote code execution vulnerability in the portable ZIP import functionality that allows users with Import Content and Create Books permissions to upload a PHP polyglot file as a book cover. Attackers can bypass image extension validation by embedding a PHP file with a .php filename in the ZIP archive, which is stored in the public web root and executed by unauthenticated requests."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/BookStackApp/BookStack"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-434"], "cwe_primary": "CWE-434", "cwe_family": "File Upload", "cwe_names": {"CWE-434": "Unrestricted Upload of File with Dangerous Type"}}, "software": {"vendors": "bookstackapp", "products": "bookstack", "cpe_uris": "cpe:2.3:a:bookstackapp:bookstack:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/BookStackApp/BookStack", "https://github.com/BookStackApp/BookStack/commit/e210cc32e4cbb1efeae5c5c9d0fef8e3c6a752e6", "https://www.vulncheck.com/advisories/bookstack-before-26.05.4-remote-code-execution-via-book-cover"], "s