{"id": "CVE-2026-82457", "identity": {"title": "CVE-2026-82457", "published": "2026-08-29 13:47:58", "modified": "2026-08-29 14:16:38", "description": "su-exec through 0.3 fails to validate numeric user and group identifiers parsed with strtol before assigning to uid_t and gid_t, allowing truncation of out-of-range values to zero. Attackers can supply large numeric identifiers that truncate to root's identifier, causing su-exec to execute target programs with root privileges instead of intended unprivileged accounts."}, "cvss": {"base_score": 8.5, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/ncopa/su-exec/blob/89c016e6e08749d583efdeda04b9f73e1218e253/su-exec.c"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-681"], "cwe_primary": "CWE-681", "cwe_family": null, "cwe_names": {"CWE-681": "Incorrect Conversion between Numeric Types"}}, "software": {"vendors": "ncopa", "products": "su-exec", "cpe_uris": "cpe:2.3:a:ncopa:su-exec:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/ncopa/su-exec/blob/89c016e6e08749d583efdeda04b9f73e1218e253/su-exec.c", "https://github.com/ncopa/su-exec", "https://gist.github.com/thesmartshadow/ed96e2a88643c34a247c9b7cf9e311be", "https://www.vulncheck.com/advisories/su-exec-through-0.3-privilege-escalation-via-numeric-user-id"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82457", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82457"}, "item_id": "CVE-2026-82457", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "3", "reason": "Privilege escalation to root in su-exec, a container runtime utility widely deployed in enterprise and cloud infrastructure.", "fail_open": false}}
{"id": "CVE-2026-82456", "identity": {"title": "CVE-2026-82456", "published": "2026-08-29 13:47:57", "modified": "2026-08-29 14:16:38", "description": "argocd-mcp 0.8.0 binds its HTTP transport to every network interface and accepts MCP sessions without requiring caller credentials when ARGOCD_API_TOKEN is configured. Attackers who can reach the listener can invoke the full tool surface using the operator's stored token to create applications, request syncs, and modify Argo CD resources."}, "cvss": {"base_score": 10.0, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/argoproj-labs/mcp-for-argocd/security/advisories/GHSA-rp45-5x3v-48mr"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-1327"], "cwe_primary": "CWE-1327", "cwe_family": null, "cwe_names": {"CWE-1327": "Binding to an Unrestricted IP Address"}}, "software": {"vendors": "argoproj-labs", "products": "argocd-mcp", "cpe_uris": "cpe:2.3:a:argoproj-labs:argocd-mcp:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/argoproj-labs/mcp-for-argocd/security/advisories/GHSA-rp45-5x3v-48mr", "https://github.com/argoproj-labs/mcp-for-argocd", "https://www.vulncheck.com/advisories/argocd-mcp-0.8.0-authentication-bypass-via-unauthenticated-http"], "sources": {"vulners_href": "http