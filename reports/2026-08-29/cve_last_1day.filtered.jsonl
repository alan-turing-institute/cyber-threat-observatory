{"id": "CVE-2026-82454", "identity": {"title": "CVE-2026-82454", "published": "2026-08-29 13:47:56", "modified": "2026-08-29 14:16:38", "description": "The Omnivore API (packages/api) before the fix in commit abf53d6 contains an authentication bypass in Apple sign-in token verification. The decodeAppleToken function extracted the 'alg' field from the attacker-supplied JWT header and passed it as the sole allowed algorithm to jwt.verify(). Using jsonwebtoken v8 (which does not validate key/algorithm compatibility), an attacker can set alg=HS256 and sign a forged token using Apple's publicly available RSA public key as the HMAC secret, bypassing signature verification and impersonating any Apple-linked account."}, "cvss": {"base_score": 9.3, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/omnivore-app/omnivore/commit/abf53d6508755d3d22a994e28e370a9193ea977a"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-347"], "cwe_primary": "CWE-347", "cwe_family": null, "cwe_names": {"CWE-347": "Improper Verification of Cryptographic Signature"}}, "software": {"vendors": "omnivore-app", "products": "omnivore", "cpe_uris": "cpe:2.3:a:omnivore-app:omnivore:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/omnivore-app/omnivore/commit/abf53d6508755d3d22a994e28e370a9193ea977a", "https://www.vulncheck.com/advisories/omnivore-before-android-0.227.0-authentication-bypass-via-apple-sign-in", "https://github.com/omnivore-app/omnivore/pull/4652", "https://github.com/omnivore-app/omnivore"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82454", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82454"}, "item_id": "CVE-2026-82454", "_relevance": {"keep": true, "score": 0.85, "primary_pir": "1", "reason": "Authentication bypass via JWT algorithm confusion in API token verification, matching identity/access weakness criteria.", "fail_open": false}}
{"id": "CVE-2026-82455", "identity": {"title": "CVE-2026-82455", "published": "2026-08-29 13:47:56", "modified": "2026-08-29 14:16:38", "description": "RubyGems fails to re-validate path containment after filesystem symlink resolution during gem extraction. When a pre-existing symlink inside the destination directory points outside the extraction root, extracted files that appear to be written under the destination directory can instead be written outside of it, breaking the extraction safety boundary. The fix resolves the real path of the parent directory before writing and raises Gem::Package::PathError if it escapes the destination directory."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/ruby/rubygems"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-59"], "cwe_primary": "CWE-59", "cwe_family": null, "cwe_names": {"CWE-59": "Improper Link Resolution Before File Access ('Link Following')"}}, "software": {"vendors": "ruby", "products": "rubygems", "cpe_uris": "cpe:2.3:a:ruby:rubygems:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/rubygems-before-4.0.13-path-traversal-via-symlink-resolution", "https://github.com/ruby/rubygems", "https://github.com/ruby/rubygems/commit/103ca4230deacb31b9fcd813de109e83b5fc71ac", "https://github.com/ruby/rubygems/pull/9493"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82455", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82455"}, "item_id": "CVE-2026-82455", "_relevance": {"keep": true, "score": 0.7, "primary_pir": "6", "reason": "Symlink escape during gem extraction in RubyGems, a core package manager with broad transitive reach in enterprise software supply chains.", "fail_open": false}}
{"id": "CVE-2026-82453", "identity": {"title": "CVE-2026-82453", "published": "2026-08-29 13:47:55", "modified": "2026-08-29 14:16:38", "description": "rust-iot-platform through commit 5df942ab stores user passwords in cleartext without hashing in the user model. Attackers can read API responses from user retrieval and listing routes to obtain plaintext credentials for all accounts."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/iot-ecology/rust-iot-platform/blob/5df942ab6bc46a3bf83dbee8c7970554f92c972d/api/src/biz/user_biz.rs"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-256"], "cwe_primary": "CWE-256", "cwe_family": null, "cwe_names": {"CWE-256": "Plaintext Storage of a Password"}}, "software": {"vendors": "iot-ecology", "products": "rust-iot-platform", "cpe_uris": "cpe:2.3:a:iot-ecology:rust-iot-platform:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/rust-iot-platform-cleartext-password-storage-via-user-model", "https://github.com/iot-ecology/rust-iot-platform/blob/5df942ab6bc46a3bf83dbee8c7970554f92c972d/api/src/biz/user_biz.rs", "https://github.com/iot-ecology/rust-iot-platform"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82