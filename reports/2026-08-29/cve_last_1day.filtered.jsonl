{"id": "CVE-2026-82461", "identity": {"title": "CVE-2026-82461", "published": "2026-08-29 16:35:25", "modified": "2026-08-29 17:17:58", "description": "pac4j-oidc before 6.5.6 fails to verify access token signatures, issuers, audiences, or expiry when extracting Keycloak realm and client roles. Attackers can forge access tokens with administrative roles paired with valid ID tokens to bypass authorization checks in applications relying on pac4j role validation."}, "cvss": {"base_score": 8.6, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/pac4j/pac4j/blob/pac4j-parent-6.5.5/pac4j-oidc/src/main/java/org/pac4j/oidc/authorization/generator/KeycloakRolesAuthorizationGenerator.java"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-347"], "cwe_primary": "CWE-347", "cwe_family": null, "cwe_names": {"CWE-347": "Improper Verification of Cryptographic Signature"}}, "software": {"vendors": "pac4j", "products": "pac4j", "cpe_uris": "cpe:2.3:a:pac4j:pac4j:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/pac4j/pac4j/blob/pac4j-parent-6.5.5/pac4j-oidc/src/main/java/org/pac4j/oidc/authorization/generator/KeycloakRolesAuthorizationGenerator.java", "https://github.com/pac4j/pac4j/commit/2270c3ff70e93cc43831e75702acd5135531237e", "https://www.pac4j