{"id": "CVE-2026-82447", "identity": {"title": "CVE-2026-82447", "published": "2026-08-29 12:05:34", "modified": "2026-08-29 13:16:38", "description": "Skyvern before 1.0.45 contains a sandbox escape vulnerability in TextPromptBlock that renders prompts twice, first through a sandboxed Jinja environment and then through an unsandboxed environment. Attackers can inject malicious Jinja template syntax through workflow parameters or upstream block output to execute arbitrary code with server process privileges."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/Skyvern-AI/skyvern/blob/v1.0.44/skyvern/forge/sdk/workflow/models/block.py"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-1336"], "cwe_primary": "CWE-1336", "cwe_family": null, "cwe_names": {"CWE-1336": "Improper Neutralization of Special Elements Used in a Template Engine"}}, "software": {"vendors": "Skyvern-AI", "products": "skyvern", "cpe_uris": "cpe:2.3:a:skyvern-ai:skyvern:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/Skyvern-AI/skyvern/blob/v1.0.44/skyvern/forge/sdk/workflow/models/block.py", "https://github.com/Skyvern-AI/skyvern/blob/v1.0.44/skyvern/forge/sdk/prompting.py", "https://www.vulncheck.com/advisories/skyvern-before-1.0.45-