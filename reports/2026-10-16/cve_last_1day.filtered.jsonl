{"id": "CVE-2026-111919", "identity": {"title": "CVE-2026-111919", "published": "2026-10-17 18:46:33", "modified": "2026-10-17 19:16:34", "description": "Vikunja 0.22.0 before 2.7.0 contains an improper access revocation vulnerability that allows removed collaborators to keep receiving project data through webhooks they created. Former collaborators keep receiving task titles and descriptions through their webhook, including content created after their access was revoked."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "NONE", "availability_impact": "NONE", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/go-vikunja/vikunja/security/advisories/GHSA-hjx8-qv73-f7cm"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-613"], "cwe_primary": "CWE-613", "cwe_family": null, "cwe_names": {"CWE-613": "Insufficient Session Expiration"}}, "software": {"vendors": "go-vikunja", "products": "vikunja", "cpe_uris": "cpe:2.3:a:go-vikunja:vikunja:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/vikunja-0.22.0-before-2.7.0-improper-access-revocation-via-webhooks", "https://github.com/go-vikunja/vikunja/security/advisories/GHSA-hjx8-qv73-f7cm"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-111919", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-111919"}, "item_id": "CVE-2026-111919", "_relevance": {"keep": true, "score": 0.55, "primary_pir": "1", "reason": "Improper access revocation allowing former collaborators to retain webhook data access in Vikunja; access control flaw in self-hosted platform.", "fail_open": false}}
{"id": "CVE-2026-111917", "identity": {"title": "CVE-2026-111917", "published": "2026-10-17 18:46:32", "modified": "2026-10-17 19:16:34", "description": "Vikunja 2.3.0 before 2.7.0 contains an improper session validation vulnerability that allows attackers to keep WebSocket access after revocation because handleAuth never checks the JWT sid claim against the sessions table. Attackers holding a stolen access token can open or maintain connections to /api/v2/ws after session deletion or TOTP enrollment, continuing to receive the victim's notification.created pushes, including comment, task and project content."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "NONE", "availability_impact": "NONE", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/go-vikunja/vikunja/security/advisories/GHSA-4hv6-xc92-j86g"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-613"], "cwe_primary": "CWE-613", "cwe_family": null, "cwe_names": {"CWE-613": "Insufficient Session Expiration"}}, "software": {"vendors": "go-vikunja", "products": "vikunja", "cpe_uris": "cpe:2.3:a:go-vikunja:vikunja:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/vikunja-2.3.0-before-2.7.0-websocket-authentication-ignores-session-revocation", "https://github.com/go-vikunja/vikunja/security/advisories/GHSA-4hv6-xc92-j86g"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-111917", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-111917"}, "item_id": "CVE-2026-111917", "_relevance": {"keep": true, "score": 0.6, "primary_pir": "1", "reason": "Improper session validation ignoring JWT sid claim allows persistent WebSocket access after revocation in Vikunja; identity/session mechanism flaw.", "fail_open": false}}
