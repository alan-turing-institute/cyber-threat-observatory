{"id": "CVE-2026-111910", "identity": {"title": "CVE-2026-111910", "published": "2026-10-17 18:46:28", "modified": "2026-10-17 19:16:33", "description": "phpMyFAQ before 4.1.9 and 4.2.0-alpha before 4.2.0-beta contains an authorization bypass vulnerability in attachment.php that allows attackers to download attachments of restricted FAQs by bypassing per-record permission checks. Low-privileged users with the dlattachment right, or anonymous users when allowDownloadsForGuests is enabled, can request attachment IDs to retrieve confidential files from restricted FAQs."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "NONE", "availability_impact": "NONE", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/thorsten/phpMyFAQ/security/advisories/GHSA-pp67-9fv9-ph7q"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-862"], "cwe_primary": "CWE-862", "cwe_family": null, "cwe_names": {"CWE-862": "Missing Authorization"}}, "software": {"vendors": "thorsten,thorsten", "products": "phpMyFAQ,phpMyFAQ", "cpe_uris": "cpe:2.3:a:thorsten:phpmyfaq:*:*:*:*:*:*