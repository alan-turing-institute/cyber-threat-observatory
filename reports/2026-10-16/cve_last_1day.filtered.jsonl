{"id": "CVE-2026-111922", "identity": {"title": "CVE-2026-111922", "published": "2026-10-17 18:46:35", "modified": "2026-10-17 19:16:34", "description": "Vikunja from 2.2.0 before 2.7.0 contains a permissive CORS configuration that trusts every localhost and 127.0.0.1 port with credentials, even when service.publicurl is set. Attackers controlling a page on any localhost port can send a credentialed request to the token refresh endpoint and read the returned bearer JWT to take over the logged-in user's account."}, "cvss": {"base_score": 7.2, "severity": "HIGH", "attack_vector": "LOCAL", "attack_complexity": "HIGH", "privileges_required": "NONE", "user_interaction": "REQUIRED", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "NONE", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/go-vikunja/vikunja/security/advisories/GHSA-m687-p538-r5hp"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "LOCAL", "privileges_required": "NONE", "user_interaction": "REQUIRED", "summary": "local, privileges: NONE, user interaction: REQUIRED"}, "weakness": {"cwe_ids": ["CWE-942"], "cwe_primary": "CWE-942", "cwe_family": null, "cwe_names": {"CWE-942": "Permissive Cross-domain Security Policy with Untrusted Domains"}}, "software": {"vendors": "go-vikunja", "products": "vikunja", "cpe_uris": "cpe:2.3:a:go-vikunja:vikunja:*:*:*:*:*:*:*:*", "software_map