{"id": "CVE-2026-111881", "identity": {"title": "CVE-2026-111881", "published": "2026-10-17 18:46:09", "modified": "2026-10-17 19:16:29", "description": "FreeRDP from 3.14.1 before 3.32.0 contains an integer underflow in the WinPR BMP writer, where a mismatched stride calculation passes SIZE_MAX - 3 to Stream_Zero for sub-byte images. A malicious RDP clipboard peer can return a crafted 1-bpp BMP processed by clipboard_synthesize_image_format_to_bmp for CF_DIB/CF_DIBV5, crashing the client or causing an out-of-bounds write."}, "cvss": {"base_score": 7.6, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "REQUIRED", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/FreeRDP/FreeRDP/security/advisories/GHSA-27m7-gwhh-6hhf"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "REQUIRED", "summary": "network, privileges: NONE, user interaction: REQUIRED"}, "weakness": {"cwe_ids": ["CWE-191"], "cwe_primary": "CWE-191", "cwe_family": null, "cwe_names": {"CWE-191": "Integer Underflow (Wrap or Wraparound)"}}, "software": {"vendors": "FreeRDP", "products": "FreeRDP", "cpe_uris": "cpe:2.3:a:freerdp:freerdp:*:*:*:*:*:*:*:*", "software_map": [{"key": "freerdp:freerdp", "vendor": "FreeRDP", "product": "FreeRDP", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/FreeRDP/FreeRDP/security/advisories/GHSA-27m7-gwhh-6hhf", "https://www.vulncheck.com/advisories/freerdp-3.14.1-before-3.32.0-integer-underflow-in-bmp-writer-via-clipboard"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-111881", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-111881"}, "item_id": "CVE-2026-111881", "_relevance": {"keep": true, "score": 0.65, "primary_pir": "1", "reason": "Widely deployed open-source RDP client with enterprise remote-access footprint and clipboard-based attack vector.", "fail_open": false}}
{"id": "CVE-2026-111882", "identity": {"title": "CVE-2026-111882", "published": "2026-10-17 18:46:09", "modified": "2026-10-18 13:16:35", "description": "phpMyFAQ 3.2.0-alpha before 4.1.9 and 4.2.0-alpha before 4.2.0-beta contains an authentication bypass vulnerability that allows IdP-authenticated users to skip TOTP two-factor authentication through the Keycloak and Entra ID SSO callbacks. Attackers holding a valid or phished IdP identity linked to a 2FA-enabled account can complete the OIDC flow and obtain a fully authenticated session, including administrator accounts."}, "cvss": {"base_score": 8.6, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "REQUIRED", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "NONE", "band": "High"}, "epss": {"score": 0.00387, "percentile": 0.31235, "date": "2026-10-18"}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/thorsten/phpMyFAQ/security/advisories/GHSA-8fvf-747v-qjr6"}, "ssvc": {"exploitation": "none", "automatable": "no", "technical_impact": "total", "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "REQUIRED", "summary": "network, privileges: NONE, user interaction: REQUIRED"}, "weakness": {"cwe_ids": ["CWE-287"], "cwe_primary": "CWE-287", "cwe_family": null, "cwe_names": {"CWE-287": "Improper Authentication"}}, "software": {"vendors": "thorsten,thorsten", "products": "phpMyFAQ,phpMyFAQ", "cpe_uris"