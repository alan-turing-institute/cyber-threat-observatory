s"}}, "software": {"vendors": "coder,coder,coder,coder", "products": "coder,coder,coder,coder", "cpe_uris": "cpe:2.3:a:coder:coder:*:*:*:*:*:*:*:*,cpe:2.3:a:coder:coder:*:*:*:*:*:*:*:*,cpe:2.3:a:coder:coder:*:*:*:*:*:*:*:*,cpe:2.3:a:coder:coder:*:*:*:*:*:*:*:*", "software_map": [{"key": "coder:coder", "vendor": "coder", "product": "coder", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/coder/coder/security/advisories/GHSA-h58h-qvv5-xvwg", "https://www.vulncheck.com/advisories/coder-before-2.35.4-credential-theft-via-workspace-proxy-hostname-prefix-match"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-111927", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-111927"}, "item_id": "CVE-2026-111927", "_relevance": {"keep": true, "score": 0.65, "primary_pir": "3", "reason": "Improper hostname validation in Coder dev platform enabling API key theft; plausible enterprise footprint and high severity warrant analysis.", "fail_open": false}}
