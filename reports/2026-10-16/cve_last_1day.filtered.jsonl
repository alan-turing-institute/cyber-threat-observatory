{"id": "CVE-2026-111880", "identity": {"title": "CVE-2026-111880", "published": "2026-10-17 18:46:08", "modified": "2026-10-17 19:16:28", "description": "FreeRDP versions from 2.0.0 before 3.32.0 contain a heap out-of-bounds write in the server hash-callback NTLM path that fails to validate the MIC offset. Unauthenticated attackers can send a crafted AUTHENTICATE_MESSAGE with a backward session-key offset and MIC offset to write 16 zero bytes beyond the allocation."}, "cvss": {"base_score": 8.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "HIGH", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "NONE", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/FreeRDP/FreeRDP/security/advisories/GHSA-cmgx-558f-vh67"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-787"], "cwe_primary": "CWE-787", "cwe_family": null, "cwe_names": {"CWE-787": "Out-of-bounds Write"}}, "software": {"vendors": "FreeRDP", "products": "FreeRDP", "cpe_uris": "cpe:2.3:a:freerdp:freerdp:*:*:*:*:*:*:*:*", "software_map": [{"key": "freerdp:freerdp", "vendor": "FreeRDP", "product": "FreeRDP", "source": "cna_vendor_product",