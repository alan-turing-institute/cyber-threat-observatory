{"id": "CVE-2026-116014", "identity": {"title": "CVE-2026-116014", "published": "2026-10-24 11:40:32", "modified": "2026-10-24 12:16:57", "description": "open62541 1.5.0 before 1.5.7 contains an integer overflow in UA_DataType_fromStructureDescription() that wraps the 16-bit memSize field for large custom structure definitions. A malicious OPC UA server can supply DataType definitions via UA_Client_getRemoteDataTypes(), causing decodeBinaryStructure() to overflow the heap, crashing clients or enabling code execution."}, "cvss": {"base_score": 9.2, "severity": "CRITICAL", "attack_vector": "NETWORK", "attack_complexity": "HIGH", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/open62541/open62541/pull/8298"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-190"], "cwe_primary": "CWE-190", "cwe_family": null, "cwe_names": {"CWE-190": "Integer Overflow or Wraparound"}}, "software": {"vendors": "open62541", "products": "open62541", "cpe_uris": "cpe:2.3:a:open62541:open62541:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/open62541/open62541/pull/8298", "https://github.com/open62541/open62541/commit/0cf4806768c493bc6ccffcd4419da24153b970ec", "https://github.com/open62541/open62541/blob/v1.5.6/src/ua_types_definition.c#L274", "https://www.vulncheck.com/advisories/open62541-1.5.0-before-1.5.7-integer-overflow-heap-buffer-overflow-via-custom-datatype", "https://github.com/open62541/open62541/releases/tag/v1.5.7", "https://github.com/open62541/open62541/pull/8302"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-116014", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-116014"}, "item_id": "CVE-2026-116014", "_relevance": {"keep": true, "score": 0.55, "primary_pir": "6.a", "reason": "Open-source OPC UA library with heap overflow leading to RCE, widely deployed in automation contexts.", "fail_open": false}}
{"id": "CVE-2026-116011", "identity": {"title": "CVE-2026-116011", "published": "2026-10-24 11:40:30", "modified": "2026-10-24 12:16:57", "description": "Crow before 1.3.4 contains an uncontrolled recursion vulnerability in crow::json::load() that allows remote unauthenticated attackers to crash the server by sending deeply nested JSON. Attackers can send a request body with thousands of nested objects to exhaust the worker thread stack, terminating the process and dropping all connections."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "NONE", "integrity_impact": "NONE", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/CrowCpp/Crow/releases/tag/v1.3.4"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-674"], "cwe_primary": "CWE-674", "cwe_family": null, "cwe_names": {"CWE-674": "Uncontrolled Recursion"}}, "software": {"vendors": "CrowCpp", "products": "Crow", "cpe_uris": "cpe:2.3:a:crowcpp:crow:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/CrowCpp/Crow/releases/tag/v1.3.4", "https://github.com/CrowCpp/