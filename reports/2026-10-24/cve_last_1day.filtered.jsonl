{"id": "CVE-2026-115973", "identity": {"title": "CVE-2026-115973", "published": "2026-10-24 18:15:15", "modified": "2026-10-24 19:17:04", "description": "A vulnerability was identified in FaveoSuite Faveo Helpdesk 2.0.3. Affected by this issue is the function ForgotPasswordController::sendResetLinkEmail/PasswordController::reset of the file app/Http/Controllers/Auth/ForgotPasswordController.php. The manipulation leads to weak password recovery. The attack may be initiated remotely. The vendor was contacted early about this disclosure."}, "cvss": {"base_score": 7.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://vuldb.com/vuln/426054/cti"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-640"], "cwe_primary": "CWE-640", "cwe_family": null, "cwe_names": {"CWE-640": "Weak Password Recovery Mechanism for Forgotten Password"}}, "software": {"vendors": "FaveoSuite", "products": "Faveo Helpdesk", "cpe_uris": "cpe:2.3:a:ladybirdweb:faveo_helpdesk:2.0.3:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://vuldb.com/vuln/426054/cti", "https://vuldb.com/submit/986184", "https://vuldb.com/cve/CVE-2026-115973", "https://vuldb.com/vuln/426054"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-115973", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-115973"}, "item_id": "CVE-2026-115973", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "1", "reason": "Weak password recovery vulnerability in enterprise helpdesk software, matching identity/access weakness keep criteria.", "fail_open": false}}
{"id": "CVE-2026-115933", "identity": {"title": "CVE-2026-115933", "published": "2026-10-24 14:17:05", "modified": "2026-10-24 15:17:33", "description": "Postiz signs its session, invitation and password reset tokens with one shared secret and without any marker of what a token is for. A route that refreshes the credentials of a browser-extension channel signed data taken from the request itself and stored the result where the requesting user can read it back. A user could therefore obtain a validly signed token containing any claims they choose, which the application accepts as a session, as an organization invitation with a chosen role, as a password reset or as an enterprise provisioning token.\n\nA second, narrower route that creates team invitations signs extra fields from the request body in the same way."}, "cvss": {"base_score": 9.9, "severity": "CRITICAL", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "CHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/gitroomhq/postiz-app/commit/a5affe62c74e39c1e7ac960d50d8418b807d532c"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-290", "CWE-345", "CWE-915"], "cwe_primary": "CWE-290", "cwe_family": null, "cwe_names": {"CWE-290": "Authentication Bypass by Spoofing", "CWE-345": "Insufficient Verification of Data Authenticity", "CWE-915": "Improperly Controlled Modification of Dynamically-Determined Object Attributes"}}, "software": {"vendors": "GitroomHQ", "products": "postiz-app", "cpe_uris": null, "software_map": [{"key": "gitroomhq:postiz-app", "vendor": "gitroomhq", "product": "postiz-app", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/gitroomhq/postiz-app/commit/a5affe62c74e39c1e7ac960d50d8418b807d532c", "https://gadvisory.org/advisories/PSA-2026-YT2HMH", "https://github.com/gitroomhq/postiz-app/releases/tag/v2.25.3", "https://github.com/gitroomhq/postiz-app"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-115933", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-115933"}, "item_id": "CVE-2026-115933", "_relevance": {"keep": true, "score": 0.9, "primary_pir": "1", "reason": "Critical token signing and session forgery vulnerability in SaaS platform affecting enterprise provisioning and password reset flows.", "fail_open": false}}
{"id": "CVE-2026-115557", "identity": {"title": "CVE-2026-115557", "published": "2026-10-24 14:15:14", "modified": "2026-10-24 18:16:48", "description": "Python has added a denylist for known compromised certificates to the \"ssl\" module to ensure user safety even without certificate revocation configured. Known compromised certificates will automatically be rejected regardless of the SSLContext policy configuration."}, "cvss": {"base_score": 9.4, "severity": "CRITICAL", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "PASSIVE", "scope": null, "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/python/cpython/pull/160042"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "PASSIVE", "summary": "network, privileges: NONE, user interaction: PASSIVE"}, "weakness": {"cwe_ids": ["CWE-299"], "cwe_primary": "CWE-299", "cwe_family": null, "cwe_names": {"CWE-299": "Improper Check for Certificate Revocation"}}, "software": {"vendors": "Python Software Foundation", "products": "CPython", "cpe_uris": null, "software_map": [{"key": "python software foundation:cpython", "vendor": "Python Software Foundation", "product": "CPython", "source": "cna_vendor_product", "sample_cpe": null, "catego