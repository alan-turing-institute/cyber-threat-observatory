odb:compass:*:*:*:*:*:*:*:*", "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/mongodb-js/compass/releases/tag/v1.53.1", "https://releases.electronjs.org/release/v44.9.1", "https://blog.mozilla.org/security/2026/10/20/protecting-firefox-users-following-the-compromise-of-emudhra-intermediate-certificates/"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-115929", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-115929"}, "item_id": "CVE-2026-115929", "_relevance": {"keep": true, "score": 0.6, "primary_pir": "3", "reason": "Enterprise database administration tool with TLS root certificate trust issue, plausible enterprise footprint but no active exploitation signal.", "fail_open": false}}
