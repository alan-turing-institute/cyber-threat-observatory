{"id": "CVE-2026-73633", "identity": {"title": "CVE-2026-73633", "published": "2026-08-14 13:48:44", "modified": "2026-08-14 15:17:11", "description": "Uncontrolled resource consumption vulnerability in the JSON plugin of Apache Struts. When an application is configured to populate actions from a JSON request body, the plugin reads that body into memory without bounding how much it will accept, so a single request can exhaust the heap and deny service to other users. The plugin's configurable JSON input length limit does not bound this read. The JSON plugin is an optional component; applications that do not use it, or use it without enabling JSON request-body handling, are not affected.\n\nThis issue affects Apache Struts: from 2.1.8 through 2.3.37, from 2.5.0 through 2.5.33, from 6.0.0 through 6.10.0, from 7.0.0 through 7.2.1.\n\nUsers are recommended to upgrade to version 6.11.0 or 7.3.0, which fixes the issue."}, "cvss": {"base_score": 7.5, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://cwiki.apache.org/confluence/display/WW/S2-072"}, "ssvc": {"exploitation": "none", "automatable": "yes", "technical_impact": "partial", "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-400"], "cwe_primary": "CWE-400", "cwe_family": null, "cwe_names": {"CWE-400": "Uncontrolled Resource Consumption"}}, "software": {"vendors": "Apache Software Foundation", "products": "Apache Struts", "cpe_uris": "cpe:2.3:a:apache:struts:*:*:*:*:*:*:*:*,cpe:2.3:a:apache:struts:*:*:*:*:*:*:*:*,cpe:2.3:a:apache:struts:*:*:*:*:*:*:*:*,cpe:2.3:a:apache:struts:*:*:*:*:*:*:*:*", "software_map": [{"key": "apache software foundation:apache struts", "vendor": "Apache Software Foundation", "product": "Apache Struts", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://cwiki.apache.org/confluence/display/WW/S2-072"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-73633", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-73633"}, "item_id": "CVE-2026-73633", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "3", "reason": "DoS in widely deployed Apache Struts web framework qualifies as platform software with broad enterprise and government footprint.", "fail_open": false}}
{"id": "CVE-2026-19768", "identity": {"title": "CVE-2026-19768", "published": "2026-08-14 13:48:03", "modified": "2026-08-14 15:17:08", "description": "Improper control of generation of code ('Code Injection') in the settings feature in Devolutions PowerShell Universal 2026.2.3 and earlier allows an authenticated user with settings management permission to execute arbitrary PowerShell code via a crafted setting value that is not properly escaped when written to the settings configuration file."}, "cvss": {"base_score": 8.1, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://devolutions.net/security/advisories/DEVO-2026-0028/"}, "ssvc": {"exploitation": "none", "automatable": "no", "technical_impact": "total", "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-94"], "cwe_primary": "CWE-94", "cwe_family": null, "cwe_names": {"CWE-94": "Improper Control of Generation of Code ('Code Injection')"}}, "software": {"vendors": "Devolutions", "products": "PowerShell Universal", "cpe_uris": null, "software_map": []}, "references": ["https://devolutions.net/security/advisories/DEVO-2026-0028/"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-19768", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-19768"}, "item_id": "CVE-2026-19768", "_relevance": {"keep": true, "score": 0.65, "primary_pir": "3",