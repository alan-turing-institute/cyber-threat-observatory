{"id": "CVE-2026-19870", "identity": {"title": "CVE-2026-19870", "published": "2026-08-14 12:08:30", "modified": "2026-08-14 15:17:09", "description": "Authorization Bypass Through User-Controlled Key in the payroll module in Roskus Prospero Flow CRM before 5.15.10 allows authenticated users holding the read payroll permission to view the salary and banking details of employees of any other company in the instance, and users holding the create payroll permission to create payroll records attributed to another company's employees, because the listing query is not scoped to the caller's company and the employee identifier is validated for global existence rather than company membership"}, "cvss": {"base_score": 8.6, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/Roskus/prospero-flow-crm/commit/59644f910b7d1aec7d1ac962b0354b3ec209977e"}, "ssvc": {"exploitation": "none", "automatable": "no", "technical_impact": "total", "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-639"], "cwe_primary": "CWE-639", "cwe_family": null, "cwe_names": {"CWE-639": "Authorization Bypass Through User-Controlled Key"}}, "software": {"vendors": "Roskus", "products": "Prospero Flow CRM", "cpe_uris": null, "software_map": []}, "references": ["https://secur0.com/en/cna/cve-list/cve-2026-19870-idor-in-prospero-flow-crm-allows-cross-tenant-payroll-disclosure-and-creation", "https://github.com/Roskus/prospero-flow-crm/commit/59644f910b7d1aec7d1ac962b0354b3ec209977e"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-19870", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-19870"}, "item_id": "CVE-2026-19870", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "2", "reason": "Enterprise CRM payroll module with authorization bypass exposing cross-tenant salary and banking data, fitting Finance sector and enterprise footprint.", "fail_open": false}}
{"id": "CVE-2026-72859", "identity": {"title": "CVE-2026-72859", "published": "2026-08-14 11:35:43", "modified": "2026-08-14 15:17:11", "description": "Budibase versions 3.39.4 before 3.40.0 contain an authorization regression in the S3 attachment upload endpoint that allows BASIC users to obtain S3 PutObject presigned URLs by sending POST requests to the attachments endpoint. The route was changed from a BUILDER permission check to a TABLE/WRITE check, which BASIC users hold by default. Attackers can specify arbitrary S3 buckets in the request body to generate presigned URLs for writing to any bucket accessible by the stored IAM credentials, enabling unauthorized file uploads."}, "cvss": {"base_score": 8.3, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/Budibase/budibase/security/advisories/GHSA-xcx6-4f2g-hhgx"}, "ssvc": {"exploitation": "poc", "automatable": "no", "technical_impact": "partial", "poc": true}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-863"], "cwe_primary": "CWE-863", "cwe_family": null, "cwe_names": {"CWE-863": "Incorrect Authorization"}}, "software": {"vendors": "budibase", "products": "server", "cpe_uris": "cpe:2.3:a:budibase:server:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/budibase-before-authorization-regression-via-s3-presigned-url", "https://github.com/Budibase/budibase/security/advisories/GHSA-xcx6-4f2g-hhgx"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72859", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72859"}, "item_id": "CVE-2026-72859", "_relevance": {"keep": true, "score": 0.7, "primary_pir": "3", "reason": "Low-code platform (Budibase) authorization regression allowing unauthorized S3 bucket writes, fitting widely deployed enterprise platform software.", "fail_open": false}}
{"id": "CVE-2026-72837", "identity": {"title": "CVE-2026-72837", "published": "2026-08-14 11:35:42", "modified": "2026-08-14 15:17:11", "description": "File Browser versions before 2.63.20 fail to honor the createUserDir isolation in proxy and hook authentication auto-provisioning paths. Attackers with valid upstream-authenticated credentials can read, modify, delete, and share files belonging to other users by exploiting the server root scope assignment."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/filebrowser/filebrowser/security/advisories/GHSA-j7jh-37pf-mf8h"}, "ssvc": {"exploitation": "poc", "automatable": "no", "technical_impact": "total", "poc": true}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-284"], "cwe_primary": "CWE-284", "cwe_family": "AuthZ/Access Control", "cwe_names": {"CWE-284": "Improper Access Control"}}, "software": {"vendors": "filebrowser", "products": "filebrowser", "cpe_uris": "cpe:2.3:a:filebrowser:filebrowser:*:*:*:*:*:*:*:*", "software_map": [{"key": "filebrowser:filebrowser", "vendor": "filebrowser", "product": "filebrowser", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/filebrowser/filebrowser/security/advisories/GHSA-j7jh-37pf-mf8h", "https://www.vulncheck.com/advisories/file-browser-before-privilege-escalation-via-proxy-authentication"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72837", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72837"}, "item_id": "CVE-2026-72837", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "3", "reason": "Self-hosted file management platform with authentication isolation bypass allowing cross-user file access, fitting widely deployed enterprise software.", "fail_open": false}}
{"id": "CVE-2026-72838", "identity": {"title": "CVE-2026-72838", "published": "2026-08-14 11:35:42", "modified": "2026-08-14 16:52:18", "description": "FileBrowser versions before 2.63.19 fail to enforce the declared Upload-Length in the TUS resumable-upload PATCH endpoint, allowing authenticated users to write arbitrary data to disk. Attackers can send oversized request bodies that exceed the declared upload length to exhaust available disk space and cause service unavailability."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/filebrowser/filebrowser/commit/4daddec6f200b03a721197d8c0b4b652c994894e"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-770"], "cwe_primary": "CWE-770", "cwe_family": null, "cwe_names": {"CWE-770": "Allocation of Resources Without Limits or Throttling"}}, "software": {"vendors": "filebrowser", "products": "filebrowser", "cpe_uris": "cpe:2.3:a:filebrowser:filebrowser:*:*:*:*:*:*:*:*", "software_map": [{"key": "filebrowser:filebrowser", "vendor": "filebrowser", "product": "filebrowser", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://www.vulncheck.com/advisories/filebrowser-before-disk-exhaustion-via-tus-upload", "https://github.com/filebrowser/filebrowser/commit/4daddec6f200b03a721197d8c0b4b652c994894e", "https://github.com/filebrowser/filebrowser/security/advisories/GHSA-ffv3-7h97-993q"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72838", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72838"}, "item_id": "CVE-2026-72838", "_relevance": {"keep": true, "score": 0.6, "primary_pir": "3", "reason": "Enterprise file management platform with authenticated disk exhaustion DoS, kept for platform footprint and recall bias.", "fail_open": false}}
{"id": "CVE-2026-72836", "identity": {"title": "CVE-2026-72836", "published": "2026-08-14 11:35:41", "modified": "2026-08-14 16:52:17", "description": "FileBrowser before 2.63.19 does not account for case-insensitive filesystems when checking home directory ownership during self-registration. When Signup and CreateUserDir are enabled and FileBrowser's root is on a case-insensitive filesystem (confirmed on Windows/NTFS), two self-registered usernames that differ only in letter case (e.g., CaseVictim and casevictim) are stored as distinct accounts but resolve to the same physical home directory, because the scope-ownership check compares the persisted scope as an exact case-sensitive string. A second registrant can therefore read, overwrite, and delete another account's files through authenticated HTTP endpoints, without needing an existing account or victim interaction."}, "cvss": {"base_score": 9.2, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/filebrowser/filebrowser/commit/fe7efb2e6afe66774cd86a5b0a03033bd514d0c0"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-178"], "cwe_primary": "CWE-178", "cwe_family": null, "cwe_names": {"CWE-178": "Improper Handling of Case Sensitivity"}}, "software": {"vendors": "filebrowser", "products": "filebrowser", "cpe_uris": "cpe:2.3:a:filebrowser:filebrowser:*:*:*:*:*:*:*:*", "software_map": [{"key": "filebrowser:filebrowser", "vendor": "filebrowser", "product": "filebrowser", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/filebrowser/filebrowser/commit/fe7efb2e6afe66774cd86a5b0a03033bd514d0c0", "https://www.vulncheck.com/advisories/filebrowser-before-case-sensitivity-authentication-bypass", "https://github.com/filebrowser/filebrowser/security/advisories/GHSA-576v-w77m-gr84"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72836", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72836"}, "item_id": "CVE-2026-72836", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "3", "reason": "File management platform authentication isolation bypass via case-insensitive filesystem allowing cross-account file access, fitting widely deployed platform software.", "fail_open": false}}
{"id": "CVE-2026-72835", "identity": {"title": "CVE-2026-72835", "published": "2026-08-14 11:35:40", "modified": "2026-08-14 12:16:46", "description": "filebrowser versions before v2.63.21 fail to canonicalize paths before evaluating access rules, allowing authenticated users to bypass administrator-defined deny rules using case-variant or backslash-separated paths. Attackers can request files with alternate path representations that match no rule but resolve to the same filesystem object, gaining unauthorized access to denied files within their scope."}, "cvss": {"base_score": 7.6, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/filebrowser/filebrowser/security/advisories/GHSA-fgm5-pw99-w2p7"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-41"], "cwe_primary": "CWE-41", "cwe_family": null, "cwe_names": {"CWE-41": "Improper Resolution of Path Equivalence"}}, "software": {"vendors": "filebrowser", "products": "filebrowser", "cpe_uris": "cpe:2.3:a:filebrowser:filebrowser:*:*:*:*:*:*:*:*", "software_map": [{"key": "filebrowser:filebrowser", "vendor": "filebrowser", "product": "filebrowser", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://www.vulncheck.com/advisories/filebrowser-before-access-rule-bypass-via-path-canonicalization", "https://github.com/filebrowser/filebrowser/security/advisories/GHSA-fgm5-pw99-w2p7"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72835", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-72835"}, "item_id": "CVE-2026-72835", "_relevance": {"keep": true, "score": 0.7, "primary_pir": "3", "reason": "Enterprise file server access control bypass via path canonicalization failure, fitting widely deployed platform software.", "fail_open": false}}
{"id": "CVE-2026-19764", "identity": {"title": "CVE-2026-19764", "published": "2026-08-14 00:45:50", "modified": "2026-08-14 15:17:08", "description": "A vulnerability was identified in Raisecom Communication Command and Dispatch Management Platform up to 7.6.5. This affects an unknown part of the file /app/users/getpwd.php. Such manipulation of the argument sip leads to sql injection. The attack can be executed remotely. The exploit is publicly available and might be used. The vendor was contacted early about this disclosure but did not respond in any way."}, "cvss": {"base_score": 7.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": 0.00254, "percentile": 0.16993, "date": "2026-08-15"}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://vuldb.com/submit/868986"}, "ssvc": {"exploitation": "poc", "automatable": "yes", "technical_impact": "partial", "poc": true}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-74", "CWE-89"], "cwe_primary": "CWE-74", "cwe_family": "Injection", "cwe_names": {"CWE-74": "Improper Neutralization of Special Elements in Output Used by a Downstream Component ('Injection')", "CWE-89": "Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"}}, "software": {"vendors": "Raisecom", "products": "Communication Command and Dispatch Management Platform", "cpe_uris": null, "software_map": []}, "references": ["https://vuldb.com/su