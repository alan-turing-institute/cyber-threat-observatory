{"id": "CVE-2026-19826", "identity": {"title": "CVE-2026-19826", "published": "2026-08-14 13:00:09", "modified": "2026-08-14 13:17:38", "description": "A vulnerability was detected in alldatacenter alldata up to 0.6.8. This affects the function Hessian2Input.readObject of the file /serialize/impl/HessianSerializer.java of the component xxl-rpc Listener. The manipulation results in deserialization. The attack may be performed from remote. The exploit is now public and may be used. The project closed the issue report as \"not planned\" without any further explanation."}, "cvss": {"base_score": 7.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/alldatacenter/alldata/issues/832"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-20", "CWE-502"], "cwe_primary": "CWE-20", "cwe_family": null, "cwe_names": {"CWE-20": "Improper Input Validation", "CWE-502": "Deserialization of Untrusted Data"}}, "software": {"vendors": "alldatacenter", "products": "alldata", "cpe_uris": "cpe:2.3:a:alldata:alldata:0.6.0:*:*:*:*:*:*:*,cpe:2.3:a:alldata:alldata:0.6.1:*:*:*:*:*:*:*,cpe:2.3:a:alldata:alldata:0.6.2:*:*:*:*:*:*:*,cpe:2.3:a:alldata:alldata:0.6.3:*:*:*:*:*:*:*,cpe:2.3:a:alldata:alldata:0.6.4:*:*:*:*:*