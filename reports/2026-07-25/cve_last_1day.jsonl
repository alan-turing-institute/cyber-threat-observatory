{"id": "CVE-2026-10818", "identity": {"title": "CVE-2026-10818", "published": "2026-07-25 06:50:06", "modified": "2026-07-25 07:17:08", "description": "The WPForms Pro plugin for WordPress is vulnerable to Arbitrary File Upload in all versions up to, and including, 1.10.1.1 via the ajax_chunk_upload_finalize function. This is due to the file type validation occurring after chunk metadata and file contents have already been written to disk, and the assembled file not being deleted upon validation failure. This makes it possible for unauthenticated attackers to upload files that may be executable, which makes remote code execution possible."}, "cvss": {"base_score": 8.1, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": 0.0042, "percentile": 0.3447, "date": "2026-07-26"}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://wpforms.com/"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-434"], "cwe_primary": "CWE-434", "cwe_family": "File Upload", "cwe_names": {"CWE-434": "Unrestricted Upload of File with Dangerous Type"}}, "software": {"vendors": "WPForms", "products": "WPForms Pro", "cpe_uris": "cpe:2.3:a:wpforms:wpforms_pro:*:*:*:*:*:wordpress:*:*", "software_map": []}, "references": ["https://wpforms.com/", "https://www.wordfence.com/threat-intel/vulnerabilities/id/b267f163-966a-43f7-8a7c-67d34c2c7e9d?source=cve"], "sources": {"vulners_href": "https://web.