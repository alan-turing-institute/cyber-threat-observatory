{"id": "CVE-2026-66373", "identity": {"title": "CVE-2026-66373", "published": "2026-07-25 00:08:35", "modified": "2026-07-25 01:16:26", "description": "Redis before 8.8.0, in the unusual case where an authenticated attacker can execute RESTORE, allows remote code execution via a RESTORE payload where the same NACK (pending entry) is referenced by more than one consumer, because deleting both consumers via XGROUP DELCONSUMER leads to a double free. NOTE: this issue exists because of an incomplete fix for CVE-2026-25243."}, "cvss": {"base_score": 7.5, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/redis/redis/compare/8.6.4...8.8.0"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-415"], "cwe_primary": "CWE-415", "cwe_family": null, "cwe_names": {"CWE-415": "Double Free"}}, "software": {"vendors": "Redis", "products": "Redis", "cpe_uris": "cpe:2.3:a:redis:redis:*:*:*:*:*:*:*:*", "software_map": [{"key": "redis:redis", "vendor": "redis", "product": "redis", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://x.com/Fried_rice/status/2080059356322918777", "https://github.com/redis/redis/compare/8.6.4...8.8.0", "https://github.com/berabuddies/redis-poc", "https://git