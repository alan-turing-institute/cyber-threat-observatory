{"id": "CVE-2026-66012", "identity": {"title": "CVE-2026-66012", "published": "2026-07-25 10:45:56", "modified": "2026-07-25 11:17:19", "description": "SiYuan before v3.7.2 contains a missing authorization vulnerability in the POST /mcp kernel endpoint, which is gated only by a general auth check (model.CheckAuth) with no admin-role or read-only enforcement. This exposes 31 MCP tools, including a file tool with list/read/write/delete/rename/copy actions across the entire workspace. When the Publish server is enabled in anonymous mode (Conf.Publish.Enable=true and Conf.Publish.Auth.Enable=false), the Publish reverse proxy attaches an anonymous RoleReader JWT to proxied requests, allowing a remote unauthenticated attacker to reach /mcp. The attacker can read conf/conf.json to extract accessAuthCode, api.token, and cookieKey in plaintext, write arbitrary files in the workspace, and plant a plugin into data/plugins/ that executes with nodeIntegration:true and no contextIsolation on the next desktop launch, leading to administrator takeover."}, "cvss": {"base_score": 10.0, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/siyuan-note/siyuan/security/advisories/GHSA-cvhv-7xhj-xjp8"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-862"], "cwe_primary": "CWE-862", "cwe_family": null, "cwe_names": {"CWE-862": "Missing Authorization"}}, "software": {"vendors": "siyuan-note", "products": "siyuan", "cpe_uris": "cpe:2.3:a:siyuan-note:siyuan:*:*:*:*:*:*:*:*", "software_map": [{"key": "siyuan-note:siyuan", "vendor": "siyuan-note", "product": "siyuan", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://www.vulncheck.com/advisories/siyuan-before-unauthenticated-administrator-takeover-via-mcp", "https://github.com/siyuan-note/siyuan/security/advisories/GHSA-cvhv-7xhj-xjp8", "https://github.com/siyuan-note/siyuan/commit/c72ca4cd09019e5f64afdee8f8c6ec5ef34858db"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-66012", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-66012"}}
{"id": "CVE-2026-66013", "identity": {"title": "CVE-2026-66013", "published": "2026-07-25 10:45:56", "modified": "2026-07-25 11:17:19", "description": "OpenRemote before 1.26.2 contains an authentication bypass vulnerability in the console registration API that allows unauthenticated attackers to update existing console assets by supplying a known asset identifier. Attackers can overwrite push notification tokens and console metadata without authentication or ownership validation, redirecting notifications or denying delivery to legitimate consoles."}, "cvss": {"base_score": 9.3, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/openremote/openremote/security/advisories/GHSA-gpfc-h59v-63cv"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-639"], "cwe_primary": "CWE-639", "cwe_family": null, "cwe_names": {"CWE-639": "Authorization Bypass Through User-Controlled Key"}}, "software": {"vendors": "openremote", "products": "openremote", "cpe_uris": "cpe:2.3:a:openremote:openremote:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/openremote-before-authentication-bypass-via-console-registration", "https://github.com/openremote/openremote/security/advisories/GHSA-gpfc-h59v-63cv"], "sources": {"vulners_href": "http