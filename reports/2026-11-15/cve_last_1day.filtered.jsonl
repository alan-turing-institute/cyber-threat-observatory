{"id": "CVE-2026-129452", "identity": {"title": "CVE-2026-129452", "published": "2026-11-15 12:30:14", "modified": "2026-11-15 13:16:59", "description": "A vulnerability has been found in DrayTek Vigor2960 1.5.1.6. This vulnerability affects the function set_table of the file /cgi-bin/mainfunction.cgi. Such manipulation of the argument jsondata leads to command injection. The attack can be launched remotely. The exploit has been disclosed to the public and may be used. Upgrading to version 1.5.1.7 is able to resolve this issue. It is suggested to upgrade the affected component. The vendor recommends: \"1.5.1.6 isn't the latest version of 2960, the latest version fixes many security issues. And we have another one in our release plan which should solve the issues reported.\""}, "cvss": {"base_score": 9.1, "severity": "CRITICAL", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "HIGH", "user_interaction": "NONE", "scope": "CHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/yikesoftware/DrayTek_Vigor2960_Security_Analysis/tree/main/cases/DRV2960-0019-authenticated-set-table-config-field-command-injection"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "HIGH", "user_interaction": "NONE", "summary": "network, privileges: H