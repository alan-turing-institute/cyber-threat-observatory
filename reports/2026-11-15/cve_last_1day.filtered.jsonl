{"id": "CVE-2026-129449", "identity": {"title": "CVE-2026-129449", "published": "2026-11-15 11:00:20", "modified": "2026-11-15 11:17:11", "description": "A security vulnerability has been detected in DrayTek Vigor2960 up to 1.5.1.6. Affected by this vulnerability is the function sub_14914 of the file /cgi-bin/mainfunction.cgi. The manipulation of the argument swmconfigupload leads to command injection. It is possible to initiate the attack remotely. The exploit has been disclosed publicly and may be used. Upgrading to version 1.5.1.7 addresses this issue. It is advisable to upgrade the affected component. The vendor recommends: \"1.5.1.6 isn't the latest version of 2960, the latest version fixes many security issues. And we have another one in our release plan which should solve the issues reported.\""}, "cvss": {"base_score": 9.9, "severity": "CRITICAL", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "CHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/yikesoftware/DrayTek_Vigor2960_Security_Analysis/blob/main/cases/DRV2960-0015-authenticated-swmconfigupload-fieldname-command-injection"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-74", "CWE-77"], "cwe_primary": "CWE-74", "cwe_family": "Injection", "cwe_names": {"CWE-74": "Improper Neutralization of Special Elements in Output Used by a Downstream Component ('Injection')", "CWE-77": "Improper Neutralization of Special Elements used in a Command ('Command Injection')"}}, "software": {"vendors": "DrayTek", "products": "Vigor2960", "cpe_uris": "cpe:2.3:h:draytek:vigor2960:1.5.1.0:*:*:*:*:*:*:*,cpe:2.3:h:draytek:vigor2960:1.5.1.1:*:*:*:*:*:*:*,cpe:2.3:h:draytek:vigor2960:1.5.1.2:*:*:*:*:*:*:*,cpe:2.3:h:draytek:vigor2960:1.5.1.3:*:*:*:*:*:*:*,cpe:2.3:h:draytek:vigor2960:1.5.1.4:*:*:*:*:*:*:*,cpe:2.3:h:draytek:vigor2960:1.5.1.5:*:*:*:*:*:*:*,cpe:2.3:h:draytek:vigor2960:1.5.1.6:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://vuldb.com/vuln/437460/cti", "https://vuldb.com/submit/1044957", "https://vuldb.com/vuln/437460", "https://github.com/yikesoftware/DrayTek_Vigor2960_Security_Analysis/blob/main/cases/DRV2960-0015-authenticated-swmconfigupload-fieldname-command-injection", "https://vuldb.com/cve/CVE-2026-129449", "https://fw.draytek.com.tw/Vigor2960/Firmware/v1.5.1.7/Vigor2960_v1.5.1.7.zip"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-129449", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-129449"}, "item_id": "CVE-2026-129449", "_relevance": {"keep": true, "score": 0.85, "primary_pir": "3", "reason": "Remote command injection in enterprise DrayTek router with publicly disclosed exploit.", "fail_open": false}}
{"id": "CVE-2026-129349", "identity": {"title": "CVE-2026-129349", "published": "2026-11-15 09:31:50", "modified": "2026-11-15 10:16:53", "description": "When authentication caching is enabled on DefaultLdapRealm, after a user logs in successfully once, subsequent logins for that user succeed with any password.\nA cached authentication skips the LDAP bind, and the AllowAllCredentialsMatcher installed by default in DefaultLdapRealm accepts any credentials, allowing an attacker who knows a valid username to authenticate as that user.\nThis issue affects all Apache Shiro versions through 3.0.0, only when using DefaultLdapRealm (or JndiLdapRealm) with authenticationCachingEnabled set to true, which is not the default.\n\nMitigation: Upgrade to version 3.0.1 or later, which fixes the issue by no longer installing AllowAllCredentialsMatcher by default.\nAlternatively, disable authentication caching on the LDAP realm (this is the default), or configure a credentials matcher, such as SimpleCredentialsMatcher, that verifies credentials against the cached authentication info."}, "cvss": {"base_score": 9.1, "severity": "CRITICAL", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": null, "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "NONE", "band": "Critical"}, "epss": {"score": 0.00543, "percentile": 0.46177, "date": "2026-11-15"}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": true, "has_exploit_reference": false, "has_public_exploit_provider": true, "has_github_exploit": true, "top_reference_url": "https://lists.apache.org/thread.html/1whn52ht402lhc782c3s843c9hho8b4y"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-287"], "cwe_primary": "CWE-287", "cwe_family": null, "cwe_names": {"CWE-287": "Improper Authentication"}}, "software": {"vendors": "Apache Software Foundation", "products": "Apache Shiro", "cpe_uris": "cpe:2.3:a:apache:shiro:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://lists.apache.org/thread.html/1whn52ht402lhc782c3s843c9hho8b4y", "http://www.openwall.com/lists/oss-security/2026/11/14/8"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-129349", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-129349"}, "item_id": "CVE-2026-129349", "_relevance": {"keep": true, "score": 0.9, "primary_pir": "1", "reason": "Apache Shiro authentication framework vulnerability allowing credential bypass via LDAP realm caching, matches Digital Identity sector and identity/access software keep trigger.", "fail_open": false}}
{"id": "CVE-2026-129360", "identity": {"title": "CVE-2026-129360", "published": "2026-11-15 03:15:17", "modified": "2026-11-15 13:20:22", "description": "A weakness has been identified in Linux Foundation Magma up to 1.9.0. The impacted element is an unknown function of the file orc8r/cloud/go/services/obsidian/access/operator.go of the component Obsidian REST. Executing a manipulation of the argument X-Magma-Client-Cert-Serial can lead to authentication bypass by spoofing. The attack can be launched remotely. The vendor was contacted early about this disclosure but did not respond in any way."}, "cvss": {"base_score": 7.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": 0.00411, "percentile": 0.35881, "date": "2026-11-15"}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": true, "has_exploit_reference": false, "has_public_exploit_provider": true, "has_github_exploit": true, "top_reference_url": "https://vuldb.com/vuln/437423/cti"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-287", "CWE-290"], "cwe_primary": "CWE-287", "cwe_family": null, "cwe_names": {"CWE-287": "Improper Authentication", "CWE-290": "Authentication Bypass by Spoofing"}}, "software": {"vendors": "Linux Foundation", "products": "Magma", "cpe_uris": "cpe:2.3:a:linuxfoundation:magma:1.0:*:*:*:*:*:*:*,cpe:2.3:a:linuxfoundation:magma:1.1:*:*:*:*:*:*:*,cpe:2.3:a:linuxfoundation:magma:1.2:*:*:*:*:*:*:*,cpe:2.3:a:linuxfoundation:magma:1.3:*:*:*:*:*:*:*,cpe:2.3:a:linuxfoundation:magma:1.4:*:*:*:*:*:*:*,cpe:2.3:a:linuxfoundation:magma:1.5:*:*:*:*:*:*:*,cpe:2.3:a:linuxfoundation:magma:1.6:*:*:*:*:*:*:*,cpe:2.3:a:linuxfoundation:magma:1.7:*:*:*:*:*:*:*,cpe:2.3:a:linuxfoundation:magma:1.8:*:*:*:*:*:*:*,cpe:2.3:a:linuxfoundation:magma:1.9.0:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://vuldb.com/vuln/437423/cti", "https://vuldb.com/vuln/437423", "https://vuldb.com/cve/CVE-2026-129360", "https://www.linuxfoundation.org/", "https://vuldb.com/submit/1044006"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-129360", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-129360"}, "item_id": "CVE-2026-129360", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "4", "reason": "Authentication bypass in Linux Foundation Magma 5G/LTE network infrastructure, relevant to core internet and telecom DPI sectors.", "fail_open": false}}
{"id": "CVE-2026-129359", "identity": {"title": "CVE-2026-129359", "published": "2026-11-15 03:00:23", "modified": "2026-11-15 13:19:56", "description": "A security flaw has been discovered in Linux Foundation Magma up to 1.9.0. The affected element is an unknown function of the file orc8r/lib/go/registry/interceptors.go. Performing a manipulation results in hard-coded credentials. The attack can be initiated remotely. The exploit has been released to the public and may be used for attacks. The vendor was contacted early about this disclosure but did not respond in any way."}, "cvss": {"base_score": 7.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": 0.00284, "percentile": 0.21161, "date": "2026-11-15"}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": true, "has_exploit_reference": false, "has_public_exploit_provider": true, "has_github_exploit": true, "top_reference_url": "https://vuldb.com/cve/CVE-2026-129359"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-259", "CWE-798"], "cwe_primary": "CWE-259", "cwe_family": null, "cwe_names": {"CWE-259": "Use of Hard-coded Password", "CWE-798": "Use of Hard-coded Credentials"}}, "software": {"vendors": "Linux Foundation", "products": "Magma", "cpe_uris": "cpe:2.3:a:l