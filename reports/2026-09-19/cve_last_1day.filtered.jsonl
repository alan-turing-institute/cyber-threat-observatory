{"id": "CVE-2026-93991", "identity": {"title": "CVE-2026-93991", "published": "2026-09-19 22:58:11", "modified": "2026-09-19 23:17:10", "description": "Argo Workflows versions 4.1.0 through 4.1.3 contain an authorization bypass vulnerability in ListArchivedWorkflows that fails to apply cluster-scoped access review when the metadata.namespace field selector uses the NotEquals operator. Attackers with namespace-scoped list permissions can use a negated namespace field selector to retrieve archived workflows from all other namespaces, exposing spec arguments, parameter values, and annotations."}, "cvss": {"base_score": 8.3, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/argoproj/argo-workflows"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-639"], "cwe_primary": "CWE-639", "cwe_family": null, "cwe_names": {"CWE-639": "Authorization Bypass Through User-Controlled Key"}}, "software": {"vendors": "argoproj", "products": "argo-workflows", "cpe_uris": "cpe:2.3:a:argoproj:argo-workflows:*:*:*:*:*:*:*:*", "software_map": [{"key": "argoproj:argo-workflows", "vendor": "argoproj", "product": "argo-workflows", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com