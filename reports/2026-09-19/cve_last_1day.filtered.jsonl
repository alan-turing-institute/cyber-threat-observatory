{"id": "CVE-2026-93990", "identity": {"title": "CVE-2026-93990", "published": "2026-09-19 22:58:11", "modified": "2026-09-19 23:17:10", "description": "Expat through 2.8.4 fails to validate low surrogates following high surrogates in UTF-16 input, allowing malformed UTF-16 sequences to be accepted. Attackers can craft UTF-16 encoded XML with lone high surrogates that consume following code units, hiding markup characters from the parser and enabling XML injection attacks."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/libexpat/libexpat/pull/1282"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-176"], "cwe_primary": "CWE-176", "cwe_family": null, "cwe_names": {"CWE-176": "Improper Handling of Unicode Encoding"}}, "software": {"vendors": "libexpat", "products": "libexpat", "cpe_uris": "cpe:2.3:a:libexpat:libexpat:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/libexpat/libexpat/pull/1282", "https://github.com/libexpat/libexpat", "https://www.vulncheck.com/advisories/expat-through-2.8.4-malformed-utf-16-acceptance-via-unchecked-surrogate", "https://github.com/libexpat/libexpat/commit/ff6e1d7e750bbe245178f51a47a965dc8342861a"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?v