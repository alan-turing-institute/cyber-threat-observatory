{"id": "CVE-2026-94107", "identity": {"title": "CVE-2026-94107", "published": "2026-09-20 11:09:40", "modified": "2026-09-20 12:17:06", "description": "NivoCart through 2.4.0 contains a predictable password reset token vulnerability in the forgotten.php endpoint that generates recovery codes using substr(md5(mt_rand()), 0, 10). Attackers who know an administrator's email address can request a password reset and predict the token to gain administrative account access without rate limiting or expiration."}, "cvss": {"base_score": 9.2, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nivocart/nivocart/issues/25"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-338"], "cwe_primary": "CWE-338", "cwe_family": null, "cwe_names": {"CWE-338": "Use of Cryptographically Weak Pseudo-Random Number Generator (PRNG)"}}, "software": {"vendors": "nivocart", "products": "nivocart", "cpe_uris": "cpe:2.3:a:nivocart:nivocart:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/nivocart/nivocart/issues/25", "https://github.com/nivocart/nivocart", "https://github.com/nivocart/nivocart/blob/6ea6600cda1263ae70c0aab0a70d31091a32c46b/upload/admin/model/user/user.php#L119-L123", "https://www.vulncheck.com/advisories/nivocart-through-2.4.0-predictable-ad