{"id": "CVE-2026-94106", "identity": {"title": "CVE-2026-94106", "published": "2026-09-20 11:09:40", "modified": "2026-09-20 12:17:06", "description": "getID3 before 1.9.26 contains an OS command injection vulnerability in shell-out handlers that fail to escape filenames in command strings. Attackers can craft malicious filenames containing shell metacharacters to inject arbitrary commands executed with the privileges of the process embedding getID3."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/JamesHeinrich/getID3/security/advisories/GHSA-qf3m-pmjh-h6fx"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-78"], "cwe_primary": "CWE-78", "cwe_family": "Command Injection", "cwe_names": {"CWE-78": "Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"}}, "software": {"vendors": "james-heinrich", "products": "getid3", "cpe_uris": "cpe:2.3:a:james-heinrich:getid3:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/getid3-before-1.9.26-os-command-injection-via-unescaped-filenames", "https://github.com/JamesHeinrich/getID3/security/advisories/GHSA-qf3m-pmjh-h6fx", "https://github.com/JamesHeinrich/getID3/commit/2c6f3f96546f05746405872848114754ed7fe9b4",