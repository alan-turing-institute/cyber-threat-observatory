{"id": "CVE-2026-94104", "identity": {"title": "CVE-2026-94104", "published": "2026-09-20 11:09:38", "modified": "2026-09-20 12:17:05", "description": "NivoCart through 2.4.0 contains an arbitrary file upload vulnerability in the File Manager multi() endpoint that fails to validate file extensions for new filenames or when chunks parameter is 2 or higher. Attackers with view-only back-office access can upload PHP files to the web-accessible image/data/ directory and execute them for remote code execution."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nivocart/nivocart/issues/25"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-434"], "cwe_primary": "CWE-434", "cwe_family": "File Upload", "cwe_names": {"CWE-434": "Unrestricted Upload of File with Dangerous Type"}}, "software": {"vendors": "nivocart", "products": "nivocart", "cpe_uris": "cpe:2.3:a:nivocart:nivocart:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/nivocart/nivocart/issues/25", "https://github.com/nivocart/nivocart", "https://github.com/nivocart/nivocart/blob/6ea6600cda1263ae70c0aab0a70d31091a32c46b/upload/admin/controller/common/filemanager.php#L527-L562", "https://www.vulncheck.com/advisories/nivocart-through-2.4.0-arbitrary-file-u