{"id": "CVE-2026-94113", "identity": {"title": "CVE-2026-94113", "published": "2026-09-20 11:56:08", "modified": "2026-09-20 12:17:07", "description": "Frappe ERPNext versions before 15.121.0 and 16.x before 16.34.0 contain an information disclosure vulnerability in whitelisted timesheet endpoints that fail to enforce doctype permissions. Authenticated attackers can call get_projectwise_timesheet_data, get_timesheet_detail_rate, and get_timesheet endpoints to enumerate and retrieve billable time logs including project names, billing amounts, and work descriptions without proper authorization checks."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/frappe/erpnext/pull/58576"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-862"], "cwe_primary": "CWE-862", "cwe_family": null, "cwe_names": {"CWE-862": "Missing Authorization"}}, "software": {"vendors": "Frappe", "products": "ERPNext", "cpe_uris": "cpe:2.3:a:frappe:erpnext:*:*:*:*:*:*:*:*,cpe:2.3:a:frappe:erpnext:*:*:*:*:*:*:*:*", "software_map": [{"key": "frappe:erpnext", "vendor": "frappe", "product": "erpnext", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/frappe/erpnext/pull/58576", "https://github.com/frappe/erpnext/security/advisories/GHSA-9vph-hqmm-g7hq", "https://github.com/frappe/erpnext/commit/d5df40986d72a55d414ddaf4d382883f9df31e41", "https://www.vulncheck.com/advisories/frappe-erpnext-before-15.121.0-and-16.34.0-missing-authorization-in-timesheet-endpoints", "https://github.com/frappe/erpnext/commit/c656497aac76af82eea028e3e8cb8d5380385f0f"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-94113", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-94113"}, "item_id": "CVE-2026-94113", "_relevance": {"keep": true, "score": 0.65, "primary_pir": "2", "reason": "Authenticated information disclosure in ERPNext, a widely deployed enterprise ERP platform with plausible finance and operations footprint.", "fail_open": false}}
{"id": "CVE-2026-94112", "identity": {"title": "CVE-2026-94112", "published": "2026-09-20 11:56:07", "modified": "2026-09-20 12:17:06", "description": "mayswind ezBookkeeping before 2.0.0 fails to invalidate TOTP passcodes after use, allowing attackers to replay captured codes within the acceptance window. Attackers with stolen credentials can authenticate and reuse a captured passcode against multiple authorization attempts for approximately 90 seconds without detection."}, "cvss": {"base_score": 7.6, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/mayswind/ezbookkeeping/commit/3dd6286d7a3ab0f980a6d36339b9c9c4df9467e4"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-294"], "cwe_primary": "CWE-294", "cwe_family": null, "cwe_names": {"CWE-294": "Authentication Bypass by Capture-replay"}}, "software": {"vendors": "mayswind", "products": "ezBookkeeping", "cpe_uris": "cpe:2.3:a:mayswind:ezbookkeeping:*:*:*:*:*:*:*:*", "software_map": [{"key": "mayswind:ezbookkeeping", "vendor": "mayswind", "product": "ezbookkeeping", "source": "cpe", "sample_cpe": "cpe:2.3:a:mayswind:ezbookkeeping:0.7.0:*:*:*:*:*:*:*", "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/mayswind/ezbookkeeping/commit/3dd6286d7a3ab0f980a6d