{"id": "CVE-2026-94108", "identity": {"title": "CVE-2026-94108", "published": "2026-09-20 11:09:41", "modified": "2026-09-20 12:17:06", "description": "getID3 through 1.9.26 contains an XML external entity injection vulnerability in the XML2array helper function that fails to properly disable entity loading on PHP before 8.0. Attackers can craft malicious XML metadata in media files to disclose local files, perform server-side request forgery, or cause denial of service through entity expansion."}, "cvss": {"base_score": 8.3, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/JamesHeinrich/getID3/commit/ce50b4b23439f87716653099718fa1c11b3d15c4"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-611"], "cwe_primary": "CWE-611", "cwe_family": null, "cwe_names": {"CWE-611": "Improper Restriction of XML External Entity Reference"}}, "software": {"vendors": "james-heinrich", "products": "getid3", "cpe_uris": "cpe:2.3:a:james-heinrich:getid3:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/JamesHeinrich/getID3/commit/ce50b4b23439f87716653099718fa1c11b3d15c4", "https://github.com/JamesHeinrich/getID3/blob/0bc49beff9c274f2490ce9a4bb76f5ef50881e08/getid3/getid3.lib.php#L742-L755", "https://www.vulncheck.com/advisories/getid3-through-1.9.26-xm