{"id": "CVE-2026-82842", "identity": {"title": "CVE-2026-82842", "published": "2026-09-20 06:00:16", "modified": "2026-09-20 14:16:58", "description": "The SAML Single Sign On  WordPress plugin before 6.0.0 does not honour the configured criterion for linking an incoming single sign-on identity to a WordPress account, always resolving the identity by login name whatever the site has chosen, which allows an attacker who can have the site's identity provider assert a login name of their choosing to authenticate as any account, including an administrator, without proving ownership of that account."}, "cvss": {"base_score": 8.1, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": 0.00132, "percentile": 0.03153, "date": "2026-09-20"}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://wpscan.com/vulnerability/4ae66b2c-a0de-405f-baca-127302257540/"}, "ssvc": {"exploitation": "none", "automatable": "no", "technical_impact": "total", "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-269"], "cwe_primary": "CWE-269", "cwe_family": null, "cwe_names": {"CWE-269": "Improper Privilege Management"}}, "software": {"vendors": "Unknown", "products": "SAML Single Sign On", "cpe_uris": "cpe:2.3:a:jenkins:saml_single_sign_on:*:*:*:*:*:wordpress:*:*", "software_map": []}, "references": ["https://wpscan.com/vulnerability/4ae66b2c-a0de-405f-baca-127302257540/"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82842", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-82842"}, "item_id": "CVE-2026-82842", "_relevance": {"keep": true, "score": 0.85, "primary_pir": "1", "reason": "SAML SSO plugin with authentication bypass allowing arbitrary account takeover; hits Identity/access software keep rule and Digital Identity sector.", "fail_open": false}}
{"id": "CVE-2026-93962", "identity": {"title": "CVE-2026-93962", "published": "2026-09-20 05:00:11", "modified": "2026-09-20 05:16:29", "description": "A weakness has been identified in Kamailio up to 5.8.8/6.0.7/6.1.4/6.2.0-dev1. The impacted element is the function shm_malloc of the file src/modules/cdp/receiver.c of the component CDP Diameter Receiver. Executing a manipulation can lead to heap-based buffer overflow. It is possible to launch the attack remotely. The exploit has been made available to the public and could be used for attacks. Upgrading to version 6.0.8 is sufficient to resolve this issue. This patch is called 38711a3e788de0130d48cb485578c482b57d9351/4f62235b6f477b649c5cc18b0c81b4e26c949b98/4f62235b6f477b649c5cc18b0c81b4e26c949b98. You should upgrade the affected component."}, "cvss": {"base_score": 8.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "CHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": 0.00529, "percentile": 0.43676, "date": "2026-09-20"}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/kamailio/kamailio/pull/4877"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-119", "CWE-122"], "cwe_primary": "CWE-119", "cwe_family": "Memory Corruption", "cwe_names": {"CWE-119": "Improper Restriction of Operations within the Bounds of a Memory Buffer", "CWE-122": "Heap-based Buffer Overflow"}}, "software