{"id": "CVE-2026-94083", "identity": {"title": "CVE-2026-94083", "published": "2026-09-20 01:18:05", "modified": "2026-09-20 02:16:53", "description": "Suricata before 8.0.7 has a DoH2 type confusion that can cause an invalid free, because cleanup code for the HTTP2 state is executed even though the actual state is HTTP1 (when there is a DoH2 request with an HTTP1 to HTTP2 upgrade). This requires app-layer.protocols.doh2 to be enabled, which is the default in 8.x versions."}, "cvss": {"base_score": 9.4, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": 0.00402, "percentile": 0.34191, "date": "2026-09-20"}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/OISF/suricata/compare/suricata-8.0.6...suricata-8.0.7"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-843"], "cwe_primary": "CWE-843", "cwe_family": null, "cwe_names": {"CWE-843": "Access of Resource Using Incompatible Type ('Type Confusion')"}}, "software": {"vendors": "OISF", "products": "Suricata", "cpe_uris": "cpe:2.3:a:oisf:suricata:*:*:*:*:*:*:*:*", "software_map": [{"key": "oisf:suricata", "vendor": "OISF", "product": "suricata", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/OISF/suricata/compare/suricata-8.0.6...suricata-8.0.7", "https://github.com/OISF/suricata/comm