{"id": "CVE-2026-112017", "identity": {"title": "CVE-2026-112017", "published": "2026-10-18 11:38:37", "modified": "2026-10-18 12:17:14", "description": "JeecgBoot before 3.9.5 contains an sql injection vulnerability that allows authenticated attackers to bypass the SqlInjectionUtil keyword blocklist by inserting newline characters into dictionary and online report SQL fragments. Attackers can send newline-separated payloads to endpoints like /sys/dict/getDictItems for boolean or time-based blind injection, extracting database contents including administrator password hashes from sys_user."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "NONE", "availability_impact": "NONE", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/jeecgboot/JeecgBoot"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-89"], "cwe_primary": "CWE-89", "cwe_family": "Injection", "cwe_names": {"CWE-89": "Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"}}, "software": {"vendors": "jeecgboot", "products": "JeecgBoot", "cpe_uris": "cp