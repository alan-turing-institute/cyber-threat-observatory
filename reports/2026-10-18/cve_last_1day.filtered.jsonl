{"id": "CVE-2026-112021", "identity": {"title": "CVE-2026-112021", "published": "2026-10-18 11:38:40", "modified": "2026-10-18 12:17:15", "description": "snac2 before 2.93 contains a heap-based buffer overflow vulnerability in _xs_json_load_lexer() that allows unauthenticated remote attackers to corrupt heap memory by sending JSON strings containing a \\u0000 escape. Attackers can send a single crafted application/activity+json POST to activitypub_post_handler(), which parses it before signature checks, overflowing heap allocations and crashing the server."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "NONE", "integrity_impact": "NONE", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://gist.github.com/nullenvk/2bf288e2d34cb3d4b7143e61dbf7d90b"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-122"], "cwe_primary": "CWE-122", "cwe_family": null, "cwe_names": {"CWE-122": "Heap-based Buffer Overflow"}}, "software": {"vendors": "grunfink", "products": "snac2", "cpe_uris": "cpe:2.3:a:grunfink:snac2:*:*:*:*:*:*:*:*", "software_map": []}, "referenc