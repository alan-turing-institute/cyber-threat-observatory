{"id": "CVE-2026-111998", "identity": {"title": "CVE-2026-111998", "published": "2026-10-18 11:38:24", "modified": "2026-10-18 12:17:11", "description": "Vanus 0.8.0 through 0.9.0 contains a default credentials vulnerability that allows unauthenticated remote attackers to gain cluster-admin access by using the hardcoded admin token. Attackers can send the fixed Bearer token to the gateway gRPC proxy port to manage namespaces, eventbuses, users, tokens, and role bindings, and read or publish events."}, "cvss": {"base_score": 9.8, "severity": "CRITICAL", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/vanus-labs/vanus/blob/v0.9.0/internal/primitive/constants.go#L37"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-1392"], "cwe_primary": "CWE-1392", "cwe_family": null, "cwe_names": {"CWE-1392": "Use of Default Credentials"}}, "software": {"vendors": "vanus-labs", "products": "vanus", "cpe_uris": "cpe:2.3:a:vanus-labs:vanus:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/