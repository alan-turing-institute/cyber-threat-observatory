{"id": "CVE-2026-112002", "identity": {"title": "CVE-2026-112002", "published": "2026-10-18 11:38:27", "modified": "2026-10-18 12:17:12", "description": "ProjectSend 2.5.0 before 2.7.0 contains an unverified password change vulnerability in PasswordController::update() that lets sessions of Social-provisioned accounts set local passwords without the current password. Attackers holding a stolen session cookie can send PUT /settings/password to create a durable local password, enroll their own second factor, and persistently take over the account."}, "cvss": {"base_score": 7.6, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "HIGH", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "NONE", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/projectsend/projectsend/releases/tag/v2.7.0"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-620"], "cwe_primary": "CWE-620", "cwe_family": null, "cwe_names": {"CWE-620": "Unverified Password Change"}}, "software": {"vendors": "ProjectSend", "products": "ProjectSend", "cpe_uris": "cpe:2.3:a:projectsend:projectsend:*:*:*:*:*:*:*:*", "software_map": [{"key": "pr