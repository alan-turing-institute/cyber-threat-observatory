{"id": "CVE-2026-90767", "identity": {"title": "CVE-2026-90767", "published": "2026-09-13 10:45:37", "modified": "2026-09-13 11:17:00", "description": "Froxlor before 2.3.12 fails to properly validate multi-line SSH public keys in the SshKeys::add() endpoint, allowing customers to inject arbitrary lines into authorized_keys files. Attackers can inject malicious SSH key entries with option directives to gain persistent unauthorized access that survives key deletion and SSH access revocation."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/froxlor/Froxlor"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-93"], "cwe_primary": "CWE-93", "cwe_family": null, "cwe_names": {"CWE-93": "Improper Neutralization of CRLF Sequences ('CRLF Injection')"}}, "software": {"vendors": "froxlor", "products": "Froxlor", "cpe_uris": "cpe:2.3:a:froxlor:froxlor:*:*:*:*:*:*:*:*", "software_map": [{"key": "froxlor:froxlor", "vendor": "froxlor", "product": "Froxlor", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/froxlor/Froxlor", "https://github.com/froxlor/Froxlor/blob/2.3.10/lib/Froxlor/Api/Commands/SshKeys.php", "https://github.com/froxlor/Froxlor/security/advisories/GHSA-p3v3-74gc-jh5f", "https://github.com/froxlor/Froxlor/blob/2.3.10/lib/Froxlor/Cron/System/SshKeys.php", "https://www.vulncheck.com/advisories/froxlor-before-2.3.12-ssh-key-injection-via-authorized-keys"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90767", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90767"}, "item_id": "CVE-2026-90767", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "1", "reason": "SSH key injection in web hosting control panel enabling persistent unauthorized access, relevant to enterprise hosting infrastructure and access control.", "fail_open": false}}
{"id": "CVE-2026-90562", "identity": {"title": "CVE-2026-90562", "published": "2026-09-13 10:45:36", "modified": "2026-09-13 11:17:00", "description": "LangBot before 4.10.11 generates password recovery keys with only 24 bits of entropy and applies no rate limiting to the unauthenticated reset-password endpoint. Remote attackers knowing the administrator email can exhaust the keyspace through concurrent requests to reset the admin password and gain account access."}, "cvss": {"base_score": 9.2, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/langbot-app/LangBot/blob/v4.10.2/src/langbot/pkg/core/stages/genkeys.py"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-331"], "cwe_primary": "CWE-331", "cwe_family": null, "cwe_names": {"CWE-331": "Insufficient Entropy"}}, "software": {"vendors": "langbot-app", "products": "LangBot", "cpe_uris": "cpe:2.3:a:langbot-app:langbot:*:*:*:*:*:*:*:*", "software_map": [{"key": "langbot-app:langbot", "vendor": "langbot-app", "product": "LangBot", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/langbot-app/LangBot/blob/v4.10.2/src/langbot/pkg/core/stages/genkeys.py", "https://www.vulncheck.com/advisories/langbot-before-4.10.11-authentication-bypass-via-weak-recovery-key", "https://github.com/langbot-app/LangBot", "https://github.com/langbot-app/LangBot/commit/267232c24f93c515d6fd3f7f81c0676066ab1ab8", "https://github.com/langbot-app/LangBot/blob/v4.10.2/src/langbot/pkg/api/http/controller/groups/user.py", "https://github.com/langbot-app/LangBot/issues/2392"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90562", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90562"}, "item_id": "CVE-2026-90562", "_relevance": {"keep": true, "score": 0.85, "primary_pir": "1", "reason": "Unauthenticated weak password recovery (CWE-640) allowing admin account takeover, matches identity/access weakness keep criteria.", "fail_open": false}}
{"id": "CVE-2026-90561", "identity": {"title": "CVE-2026-90561", "published": "2026-09-13 10:45:35", "modified": "2026-09-13 11:17:00", "description": "Strapi versions 4.x through 4.26.2 and 5.x before 5.48.1 contain a stored cross-site scripting vulnerability in the content manager WYSIWYG preview component that fails to strip script tags from rich text. An Author-role user can store malicious script tags in rich text fields that execute in an Editor or Super Admin's session when the preview pane is expanded, enabling account takeover."}, "cvss": {"base_score": 9.3, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/strapi/strapi/blob/v5.46.0/packages/core/content-manager/admin/src/pages/EditView/components/FormInputs/Wysiwyg/PreviewWysiwyg.tsx"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-79"], "cwe_primary": "CWE-79", "cwe_family": "XSS", "cwe_names": {"CWE-79": "Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')"}}, "software": {"vendors": "strapi", "products": "strapi", "cpe_uris": "cpe:2.3:a:strapi:strapi:*:*:*:*:*:*:*:*,cpe:2.3:a:strapi:strapi:*:*:*:*:*:*:*:*", "software_map": [{"key": "strapi:strapi", "vendor": "strapi", "product": "strapi", "source": "cna_vendor_product", "sample_cpe": null, "category"