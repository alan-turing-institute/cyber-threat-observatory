{"id": "CVE-2026-90509", "identity": {"title": "CVE-2026-90509", "published": "2026-09-13 10:00:08", "modified": "2026-09-13 10:16:56", "description": "A weakness has been identified in dromara orion-visor up to 2.5.7. Affected by this issue is the function ExposeApiAspect.beforeExposeApi of the file ExposeApiAspect.java. Executing a manipulation can lead to hard-coded credentials. The attack can be executed remotely. The exploit has been made available to the public and could be used for attacks. The project was informed of the problem early through an issue report but has not responded yet."}, "cvss": {"base_score": 7.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/sumo166/CVE-apply/blob/main/dromara-orion-visor/ExposeApi%20Hardcoded%20Default%20Token%20Authentication%20Bypass%20(CWE-798)_en.md"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-259", "CWE-798"], "cwe_primary": "CWE-259", "cwe_family": null, "cwe_names": {"CWE-259": "Use of Hard-coded Password", "CWE-798": "Use of Hard-coded Credentials"}}, "software": {"vendors": "dromara", "products": "orion-visor", "cpe_uris": "cpe:2.3:a:dromara:orion-visor:2.5.0:*:*:*:*:*:*:*,cpe:2.3:a:dromara:orion-visor:2.5.1:*:*:*:*:*:*:*,cpe:2.3:a:dromara:orion-visor:2.5.2:*:*:*:*:*:*:*,cpe:2.3:a:dromara:orion-visor:2.5.3:*:*:*:*:*:*:*,cpe:2.3:a:dromara:orion-visor:2.5.4:*:*:*:*:*:*:*,cpe:2.3:a:dromara:orion-visor:2.5.5:*:*:*:*:*:*:*,cpe:2.3:a:dromara:orion-visor:2.5.6:*:*:*:*:*:*:*,cpe:2.3:a:dromara:orion-visor:2.5.7:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/sumo166/CVE-apply/blob/main/dromara-orion-visor/ExposeApi%20Hardcoded%20Default%20Token%20Authentication%20Bypass%20(CWE-798)_en.md", "https://vuldb.com/vuln/403097/cti", "https://vuldb.com/vuln/403097", "https://github.com/dromara/orion-visor/", "https://vuldb.com/cve/CVE-2026-90509", "https://vuldb.com/submit/911864", "https://github.com/dromara/orion-visor/issues/170"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90509", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90509"}, "item_id": "CVE-2026-90509", "_relevance": {"keep": true, "score": 0.8, "primary_pir": "1", "reason": "Hard-coded credentials in enterprise IT management platform with publicly disclosed exploit, matches identity/access weakness criteria.", "fail_open": false}}
{"id": "CVE-2026-90678", "identity": {"title": "CVE-2026-90678", "published": "2026-09-13 03:37:55", "modified": "2026-09-13 04:17:25", "description": "An issue was discovered in HAProxy 3.3.0 through 3.4.4 and in 3.5-dev1 through 3.5-dev5. Exploitation requires an HTTP/3 frontend: HAProxy must be built with QUIC support and configured with a QUIC bind listener, and the affected traffic must reach a backend over HTTP/1.1 using chunked transfer coding on a reused connection. Under those conditions, when an HTTP/3 request carries no Content-Length header, the HTTP/3 multiplexer credits the length declared in a DATA frame header to the stream endpoint's known-input-payload estimate at the moment the frame header is decoded, before the payload has been received, and that declared length is emitted verbatim as the HTTP/1.1 chunk size. A remote unauthenticated client that declares more payload than it delivers and then ends the stream causes HAProxy to announce a chunk larger than the bytes it writes and to return the connection to the idle pool in a desynchronized state. The result is potential HTTP request smuggling on reused backend connections: an attacker can place a request past a frontend rule such as a path-based http-request deny, so that the smuggled request is never seen by HAProxy's HTTP analysis, and can cause concurrent clients' requests, including their request lines and Authorization headers, to be consumed as the attacker's request body and lost. Exploitation is not deterministic; it depends on a race with backend connection pooling, succeeding in a majority of but not all trials during testing, and can be retried freely. The mechanism was introduced in 3.3-dev10; releases 3.2.x and earlier are unaffected."}, "cvss": {"base_score": 7.5, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/haproxy/haproxy/commit/86a4ebc761a278838e8cb06f3a292282ba704c65"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-130"], "cwe_primary": "CWE-130", "cwe_family": null, "cwe_names": {"CWE-130": "Improper Handling of Length Parameter Inconsistency"}}, "software": {"vendors": "HAProxy", "products": "HAProxy", "cpe_uris": "cpe:2.3:a:haproxy:haproxy:*:*:*:*:*:*:*:*,cpe:2.3:a:haproxy:haproxy:*:*:*:*:*:*:*:*,cpe:2.3:a:haproxy:haproxy:*:*:*:*:*:*:*:*", "software_map": [{"key": "haproxy:haproxy", "vendor": "HAProxy", "product": "HAProxy", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["http://git.haproxy.org/?p=haproxy.git;a=commit;h=86a4ebc761a278838e8cb06f3a292282ba704c65", "https://github.com/haproxy/haproxy/commit/86a4ebc761a278838e8cb06f3a292282ba704c65", "https://www.haproxy.org/download/3.5/src/CHANGELOG"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90678", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90678"}, "item_id": "CVE-2026-90678", "_relevance": {"keep": true, "score": 0.8, "primary_pir": "3", "reason": "Widely deployed load balancer/proxy with remote unauthenticated exploitation path, fitting platform software and core internet infrastructure criteria.", "fail_open": false}}
{"id": "CVE-2026-90495", "identity": {"title": "CVE-2026-90495", "published": "2026-09-13 03:30:05", "modified": "2026-09-13 04:17:15", "description": "A vulnerability has been found in Fengoffice Feng Office up to 3.11.13.11. This impacts the function Contacts::instance->findAll of the file application/models/CompanyWebsite.class.php of the component Legacy API. Such manipulation of the argument auth leads to sql injection. The attack can be launched remotely. The exploit has been disclosed to the public and may be used. The vendor was contacted early about this disclosure but did not respond in any way."}, "cvss": {"base_score": 7.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://vuldb.com/vuln/403083/cti"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-74", "CWE-89"], "cwe_primary": "CWE-74", "cwe_family": "Injection", "cwe_names": {"CWE-74": "Improper Neutralization of Special Elements in Output Used by a Downstream Component ('Injection')", "CWE-89": "Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')"}}, "software": {"vendors": "Fengoffice", "products": "Feng Office", "cpe_uris": "cpe:2.3:a:fengoffice:feng_office:3.11.13.0:*:*:*:*:*:*:*,cpe:2.3:a:fengo