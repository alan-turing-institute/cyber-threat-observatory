{"id": "CVE-2026-90579", "identity": {"title": "CVE-2026-90579", "published": "2026-09-13 19:00:09", "modified": "2026-09-13 19:16:53", "description": "A vulnerability has been found in cheshire-cat-ai Cheshire Cat AI up to 1.9.2. This affects the function _authorize_http_key of the file core/cat/factory/custom_auth_handler.py. The manipulation of the argument user_id leads to missing authentication. The attack may be initiated remotely. The exploit has been disclosed to the public and may be used. The project was informed of the problem early through an issue report but has not responded yet."}, "cvss": {"base_score": 7.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/cheshire-cat-ai/core/issues/1137"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-287", "CWE-306"], "cwe_primary": "CWE-287", "cwe_family": null, "cwe_names": {"CWE-287": "Improper Authentication", "CWE-306": "Missing Authentication for Critical Function"}}, "software": {"vendors": "cheshire-cat-ai", "products": "Cheshire Cat AI", "cpe_uris": null, "software_map": []}, "references": ["https://vuldb.com/submit/913219", "https://github.com/cheshire-cat-ai/core/issues/1137", "https://vuldb.com/cve/CVE-2026-90579", "https://vuldb.com/vuln/403164", "https://vuldb.com/vuln/403164/cti"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90579", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90579"}, "item_id": "CVE-2026-90579", "_relevance": {"keep": true, "score": 0.6, "primary_pir": "3", "reason": "AI agent framework with publicly disclosed missing authentication vulnerability and plausible enterprise deployment footprint.", "fail_open": false}}
{"id": "CVE-2026-90777", "identity": {"title": "CVE-2026-90777", "published": "2026-09-13 11:42:27", "modified": "2026-09-13 12:17:16", "description": "ESPnet before 202609 deserializes pretrained model checkpoints using torch.load with weights_only=False, allowing arbitrary code execution from attacker-supplied files. Attackers can craft malicious checkpoint files that execute code during deserialization when loaded through the initialization or fine-tuning path."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/espnet/espnet"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-502"], "cwe_primary": "CWE-502", "cwe_family": null, "cwe_names": {"CWE-502": "Deserialization of Untrusted Data"}}, "software": {"vendors": "espnet", "products": "espnet", "cpe_uris": "cpe:2.3:a:espnet:espnet:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/espnet/espnet", "https://github.com/espnet/espnet/security/advisories/GHSA-64f6-3gqc-r926", "https://github.com/espnet/espnet/commit/91ca045fc179f29bc7b7fe05cd852aea65310003", "https://github.com/espnet/espnet/releases/tag/v.202609", "https://www.vulncheck.com/advisories/espnet-before-202609-remote-code-execution-via-unsafe-deserialization", "https://github.com/espnet/espnet/blob/v.202511/espnet2/torch_utils/load_pretrained_model.py#L99"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90777", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90777"}, "item_id": "CVE-2026-90777", "_relevance": {"keep": true, "score": 0.6, "primary_pir": "3", "reason": "AI/ML framework component with deserialization RCE, plausible supply chain risk for research and enterprise ML pipelines.", "fail_open": false}}
{"id": "CVE-2026-90776", "identity": {"title": "CVE-2026-90776", "published": "2026-09-13 11:42:26", "modified": "2026-09-13 12:17:16", "description": "Nodemailer versions 9.1.0 through 10.0.4 contain a quadratic time complexity vulnerability in the addressparser component when parsing email addresses with RFC 5322 comments. Attackers can craft malicious email headers with comment-separated atoms to consume excessive CPU and block the Node.js event loop for several seconds, causing denial of service."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nodemailer/nodemailer/releases/tag/v10.0.5"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-407"], "cwe_primary": "CWE-407", "cwe_family": null, "cwe_names": {"CWE-407": "Inefficient Algorithmic Complexity"}}, "software": {"vendors": "nodemailer", "products": "nodemailer", "cpe_uris": "cpe:2.3:a:nodemailer:nodemailer:*:*:*:*:*:*:*:*", "software_map": [{"key": "nodemailer:nodemailer", "vendor": "nodemailer", "product": "nodemailer", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/nodemailer/nodemailer/releases/tag/v10.0.5", "https://github.com/nodemailer/nodemailer/commit/c07f17518d25aca8ab2ad66968dcbca538c24b89", "https://github.com/nodemailer/nodemailer/security/advisories/GHSA-prgh-xp8r-p3m5", "https://www.vulncheck.com/advisories/nodemailer-9.1.0-through-10.0.4-denial-of-service-via-quadratic-address-parsing", "https://github.com/nodemailer/nodemailer", "https://github.com/nodemailer/nodemailer/blob/v10.0.4/src/addressparser/index.ts#L251"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90776", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90776"}, "item_id": "CVE-2026-90776", "_relevance": {"keep": true, "score": 0.7, "primary_pir": "3", "reason": "Widely deployed Node.js email library with public-facing DoS risk, plausible enterprise application footprint.", "fail_open": false}}
{"id": "CVE-2026-90775", "identity": {"title": "CVE-2026-90775", "published": "2026-09-13 11:07:30", "modified": "2026-09-13 12:17:16", "description": "PostGIS address_standardizer through 3.7.0 fails to validate the Weight parameter from caller-supplied rules tables before using it as an array index. Attackers can craft malicious rule rows with out-of-range Weight values to trigger out-of-bounds reads in the load_value array, causing the PostgreSQL backend process to crash and terminate all cluster sessions."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/postgis/address_standardizer/blob/v3.7.0/src/analyze.c#L860"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-125"], "cwe_primary": "CWE-125", "cwe_family": null, "cwe_names": {"CWE-125": "Out-of-bounds Read"}}, "software": {"vendors": "PostGIS", "products": "address_standardizer", "cpe_uris": "cpe:2.3:a:postgis:address\\_standardizer:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/postgis/address_standardizer/blob/v3.7.0/src/analyze.c#L860", "https://github.com/postgis/address_standardizer", "https://github.com/postgis/address_standardizer/commit/a5cb4b1360a040973092f13b1af97a718e7e104a", "https://github.com/postgis/address_standardizer/commit/e987949e0fccff6a0e7a6d3f86814d5c7a01f481", "https://github.com/postgis/address_standardizer/blob/e987949e0fccff6a0e7a6d3f86814d5c7a01f481/NEWS.md", "https://github.com/postgis/address_standardizer/blob/v3.7.0/src/gamma.c#L301-L311", "https://github.com/postgis/address_standardizer/pull/6", "https://www.vulncheck.com/advisories/postgis-address-standardizer-through-3.7.0-out-of-bounds-read-via-unvalidated-rule-weight"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90775", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-90775"}, "item_id": "CVE-2026-90775", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "3", "reason": "Critical database extension (PostGIS/PostgreSQL) with cluster-wide DoS impact, widely deployed in enterprise and government GIS infrastructure.", "fail_open": false}}
{"id": "CVE-2026-90772", "identity": {"title": "CVE-2026-90772", "published": "2026-09-13 10:45:43", "modified": "2026-09-13 11:17:01", "description": "Amundsen frontend through 4.3.0 renders table, dashboard, and feature descriptions with dangerouslySetInnerHTML without HTML sanitization in ResourceListItem components. Attackers can inject malicious markup like img elements with onerror handlers into descriptions via the metadata service or Elasticsearch, executing JavaScript in every user's browser that views search results."}, "cvss": {"base_score": 8.3, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/amundsen-io/amundsen/blob/frontend-4.3.0/frontend/amundsen_application/static/js/components/ResourceListItem/TableListItem/index.tsx"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-79"], "cwe_primary": "CWE-79", "cwe_family": "XSS", "cwe_names": {"CWE-79": "Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')"}}, "software": {"vendors": "amundsen-io", "products": "amundsen-frontend", "cpe_uris": "cpe:2.3:a:amundsen-io:amundsen-frontend:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/amundsen-frontend-through-4.3.0-stored-xss-via-description", "https://github.com/amundsen-io/am