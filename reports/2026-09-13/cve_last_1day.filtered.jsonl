{"id": "CVE-2026-90770", "identity": {"title": "CVE-2026-90770", "published": "2026-09-13 10:45:41", "modified": "2026-09-13 11:17:01", "description": "Spug through 3.4.0 contains a remote code execution vulnerability in the ping_check function that interpolates user-supplied monitor addresses directly into shell commands without validation. Authenticated users with monitor permissions can inject shell metacharacters via the /monitor/run_test/ endpoint to execute arbitrary commands as the Spug process user."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/openspug/spug/blob/v3.4.0/spug_api/apps/monitor/executors.py"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-78"], "cwe_primary": "CWE-78", "cwe_family": "Command Injection", "cwe_names": {"CWE-78": "Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"}}, "software": {"vendors": "openspug", "products": "spug", "cpe_uris": "cpe:2.3:a:openspug:spug:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/openspug/spug/blob/v3.4.0/spug_api/apps/monitor/executors.py", "https://github.com/openspug/spug/issues/741", "https://www.vulncheck.com/advisories/spug-through-3.4.0-remote-code-execution-via-ping-check", "https://gi