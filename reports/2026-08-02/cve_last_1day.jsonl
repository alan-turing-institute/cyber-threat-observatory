{"id": "CVE-2026-18577", "identity": {"title": "CVE-2026-18577", "published": "2026-08-02 22:06:18", "modified": "2026-08-02 23:16:26", "description": "An incomplete patch for CVE-2026-18556 allows for authentication bypass and account takeover in N-central Versions through 2026.3.1"}, "cvss": {"base_score": 8.2, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://www.cve.org/CVERecord?id=CVE-2026-18556"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-288"], "cwe_primary": "CWE-288", "cwe_family": null, "cwe_names": {"CWE-288": "Authentication Bypass Using an Alternate Path or Channel"}}, "software": {"vendors": "N-able", "products": "N-central", "cpe_uris": null, "software_map": [{"key": "n-able:n-central", "vendor": "N-able", "product": "N-central", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://www.cve.org/CVERecord?id=CVE-2026-18556", "https://documentation.n-able.com/N-central/Release_Notes/GA/Content/N-central_2026.3_HF1_Release_Notes.htm", "https://status.n-able.com/2026/08/02/n-central-2026-3-hotfix-1-mitigation-for-cve-2026-18577/"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-18577", "nvd_href": "https://web.nvd.nist