{"id": "CVE-2026-118636", "identity": {"title": "CVE-2026-118636", "published": "2026-10-31 20:17:11", "modified": "2026-10-31 21:16:53", "description": "**UNSUPPORTED WHEN ASSIGNED** \n\nJavaNativeMessageDecoder in the MINA 3.0 codec module calls ObjectInputStream.readObject() on frame bytes with no class filter, so an\napplication that puts it in front of an untrusted peer is open to gadget-chain RCE.\n\nAs the 3.0.0 branch is inactive, we do not plan to release a version that fixes this issue. \n\nUsers are recommended to use the latest Apache MINA 2.2.X branch."}, "cvss": {"base_score": 9.8, "severity": "CRITICAL", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://www.cve.org/CVERecord?id=CVE-2026-118636"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-502"], "cwe_primary": "CWE-502", "cwe_family": null, "cwe_names": {"CWE-502": "Deserialization of Untrusted Data"}}, "software": {"vendors": "Apache Software Foundation", "products": "Apache MINA", "cpe_uris": "cpe:2.3:a:apache:mina:3.0.0:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.cve.org/CVERecord?id=CVE-2026-118636", "https://lists.apache.org/thread.html/h76nwcrkvsffhsk2kq6cjzc6srtnty7x", "http://www.openwall.com/lists/oss-security/2026/10/31/3"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-118636", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-118636"}, "item_id": "CVE-2026-118636", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "3", "reason": "Network RCE via unsafe deserialization in Apache MINA, a widely deployed Java networking framework with enterprise footprint.", "fail_open": false}}
{"id": "CVE-2026-120209", "identity": {"title": "CVE-2026-120209", "published": "2026-10-31 17:25:56", "modified": "2026-10-31 18:17:09", "description": "AJ-Report through 1.7.1 signs share tokens with a hard-coded JWT secret, allowing attackers to forge valid Share-Tokens offline. Attackers can mint a token with reportCode 'dataSet' to access the testTransform endpoint, which passes scripts to GroovyClassLoader for unauthenticated remote code execution."}, "cvss": {"base_score": 9.8, "severity": "CRITICAL", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://gitee.com/belief-team/report"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-321"], "cwe_primary": "CWE-321", "cwe_family": null, "cwe_names": {"CWE-321": "Use of Hard-coded Cryptographic Key"}}, "software": {"vendors": "anji-plus", "products": "AJ-Report", "cpe_uris": "cpe:2.3:a:anji-plus:aj-report:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://gitee.com/belief-team/report", "https://gitee.com/belief-team/report/issues/IKRV6T", "http