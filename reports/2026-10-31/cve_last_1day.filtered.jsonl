{"id": "CVE-2026-120208", "identity": {"title": "CVE-2026-120208", "published": "2026-10-31 17:25:55", "modified": "2026-10-31 18:17:09", "description": "libheif 1.18.0 before 1.23.3 contains a heap-based buffer overflow vulnerability in unc_decoder_mixed_interleave::processTile() that allows attackers to write out of bounds by supplying chroma components with unequal bit depths. Attackers can craft a HEIF file declaring, for example, 16-bit Cb and 8-bit Cr to trigger file-controlled heap writes past the Cr plane, potentially achieving code execution in image-processing pipelines."}, "cvss": {"base_score": 7.7, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "HIGH", "privileges_required": "NONE", "user_interaction": "REQUIRED", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/strukturag/libheif/blob/v1.23.2/libheif/codecs/uncompressed/unc_decoder_mixed_interleave.cc#L95"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "REQUIRED", "summary": "network, privileges: NONE, user interaction: REQUIRED"}, "weakness": {"cwe_ids": ["CWE-122"], "cwe_primary": "CWE-122", "cwe_family": null, "cwe_names": {"CWE-122": "Heap-based Buffer Overflow"}}, "software": {"vendors": "strukturag", "products": "libheif", "cpe_uris": "cpe:2.3:a:struktur:libheif:*:*:*:*:*:*:*:*", "software_map": [{"key": "strukturag:libheif", "vendor": "strukturag", "product": "libheif", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://www.vulncheck.com/advisories/libheif-1.18.0-before-1.23.3-heap-buffer-overflow-via-unci-mixed-interleave-decoder", "https://github.com/strukturag/libheif/blob/v1.23.2/libheif/codecs/uncompressed/unc_decoder_mixed_interleave.cc#L95", "https://github.com/strukturag/libheif/commit/9d3cd91d7b1c8c68deef6d06057ab956bcb0dfb9", "https://github.com/strukturag/libheif/security/advisories/GHSA-x8r2-mggj-j6wr", "https://github.com/strukturag/libheif/releases/tag/v1.23.3"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-120208", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-120208"}, "item_id": "CVE-2026-120208", "_relevance": {"keep": true, "score": 0.7, "primary_pir": "3", "reason": "Heap overflow RCE in libheif, a widely deployed image decoding library with broad transitive enterprise reach.", "fail_open": false}}
{"id": "CVE-2026-120203", "identity": {"title": "CVE-2026-120203", "published": "2026-10-31 17:25:52", "modified": "2026-10-31 18:17:08", "description": "ShowDoc 2.8.14 before 3.9.6 contains a code injection vulnerability in its Mock feature that allows authenticated users to execute shell commands through mockjs templates. Attackers can store a template via MockController::add with escaped parentheses that mockjs evaluates with eval(), then trigger it through MockController::infoByKey to run commands, as root in the official Docker image."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://gist.github.com/LioTree/028af150fd991cf9924dd2c7d5912e54"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-94"], "cwe_primary": "CWE-94", "cwe_family": null, "cwe_names": {"CWE-94": "Improper Control of Generation of Code ('Code Injection')"}}, "software": {"vendors": "ShowDoc", "products": "ShowDoc", "cpe_uris": "cpe:2.3:a:showdoc:showdoc:*:*:*:*:*:*:*:*", "software_map": [{"ke