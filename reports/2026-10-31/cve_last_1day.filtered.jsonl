{"id": "CVE-2026-117681", "identity": {"title": "CVE-2026-117681", "published": "2026-10-31 08:57:35", "modified": "2026-10-31 09:16:33", "description": "A flaw was found in konflux-ci. This vulnerability allows privilege escalation when the user interface proxy automatically disables Transport Layer Security (TLS) certificate verification for connections to internal backend services in environments lacking a default service certificate authority. Because the proxy attaches a cluster-scoped authentication token with user impersonation rights to these requests, an adjacent network attacker capable of intercepting traffic can capture the credentials to gain full administrative control of the cluster."}, "cvss": {"base_score": 8.0, "severity": "HIGH", "attack_vector": "ADJACENT", "attack_complexity": "HIGH", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "CHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": 0.00097, "percentile": 0.00702, "date": "2026-10-31"}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://access.redhat.com/security/cve/CVE-2026-117681"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "ADJACENT", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "adjacent, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-295"], "cwe_primary": "CWE-295", "cwe_family": null, "cwe_names": {"CWE-295": "Improper Certificate Validation"}}, "software": {"vendors": null, "products": null, "cpe_uris": "cpe:2.3:a:konflux:ci:0.2.2-rc.2:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://access.redhat.com/security/cve/CVE-2026-117681", "https://bugzilla.redhat.com/show_bug.cgi?id=2563233"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-117681", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-117681"}, "item_id": "CVE-2026-117681", "_relevance": {"keep": true, "score": 0.8, "primary_pir": "3", "reason": "Privilege escalation and credential theft in konflux-ci, a widely deployed CI/CD platform with enterprise footprint.", "fail_open": false}}
{"id": "CVE-2026-116964", "identity": {"title": "CVE-2026-116964", "published": "2026-10-31 08:57:31", "modified": "2026-10-31 09:16:33", "description": "A flaw was found in konflux-ci. An attacker with repository write access can achieve arbitrary code execution within the Continuous Integration and Continuous Delivery (CI/CD) workflow environment. By injecting shell commands into environment export scripts, the attacker causes manifest synchronization scripts to dynamically evaluate unvalidated script output. Successful exploitation allows the attacker to compromise CI/CD pipelines, steal sensitive authentication tokens and deployment credentials, and gain unauthorized access to production systems."}, "cvss": {"base_score": 8.4, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "HIGH", "user_interaction": "REQUIRED", "scope": "CHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": 0.00337, "percentile": 0.27145, "date": "2026-10-31"}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://access.redhat.com/security/cve/CVE-2026-116964"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "HIGH", "user_interaction": "REQUIRED", "summary": "network, privileges: HIGH, user interaction: REQUIRED"}, "weakness": {"cwe_ids": ["CWE-94"], "cwe_primary": "CWE-94", "cwe_family": null, "cwe_names": {"CWE-94": "Improper Control of Generation of Code ('Code Injection')"}}, "software": {"vendors": null, "products": null, "cpe_uris": "cpe:2.3:a:konflux:ci:*:*:*:*:*:*:*:*,cpe:2.3:a:konflux:ci:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://access.redhat.com/security/cve/CVE-2026-116964", "https://bugzilla.redhat.com/show_bug.cgi?id=2564209"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-116964", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-116964"}, "item_id": "CVE-2026-116964", "_relevance": {"keep": true, "score": 0.8, "primary_pir": "3", "reason": "Arbitrary code execution in konflux-ci CI/CD pipelines enabling credential theft, fitting the widely deployed platform software keep criterion.", "fail_open": false}}
{"id": "CVE-2026-116086", "identity": {"title": "CVE-2026-116086", "published": "2026-10-31 08:55:12", "modified": "2026-10-31 09:16:33", "description": "A flaw was found in konflux-ci. An attacker with permission to trigger automated workflow runs can cause an information disclosure by providing crafted issue titles to workflow scripts. The affected script incorporates user-provided titles directly into data queries without adequate sanitization, allowing the attacker to inject malicious filter commands. As a result, sensitive information such as API credentials, deployment keys, and internal notes returned from repository queries may be exposed in workflow logs."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": 0.0031, "percentile": 0.2394, "date": "2026-10-31"}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://bugzilla.redhat.com/show_bug.cgi?id=2564224"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-94"], "cwe_primary": "CWE-94", "cwe_family": null, "cwe_names": {"CWE-94": "Improper Control of Generation of Code ('Code Injection')"}}, "software": {"vendors": null, "products": null, "cpe_uris": "cpe:2.3:a:konflux:ci:*:*:*:*:*:*:*:*,cpe:2.3:a:konflux:ci:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://bugzilla.redhat.com/show_bug.cgi?id=2564224", "https://access.redhat.com/security/cve/CVE-2026-116086"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-116086", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-116086"}, "item_id": "CVE-2026-116086", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "3", "reason": "Information disclosure of API credentials and deployment keys in konflux-ci CI/CD workflows, fitting the widely deployed platform software keep criterion.", "fail_open": false}}
{"id": "CVE-2026-114217", "identity": {"title": "CVE-2026-114217", "published": "2026-10-31 08:55:09", "modified": "2026-10-31 09:16:33", "description": "A flaw was found in konflux-ci. Continuous Integration (CI) automation scripts store sensitive GitHub access tokens in plaintext on the runner without cleaning them up after execution. A local attacker with access to the CI environment can read these stored credentials to gain unauthorized repository access, potentially allowing them to modify source code or release artifacts."}, "cvss": {"base_score": 8.6, "severity": "HIGH", "attack_vector": "LOCAL", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "REQUIRED", "scope": "CHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": 0.00086, "percentile": 0.00305, "date": "2026-10-31"}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://access.redhat.com/security/cve/CVE-2026-114217"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "LOCAL", "privileges_required": "NONE", "user_interaction": "REQUIRED", "summary": "local, privileges: NONE, user interaction: REQUIRED"}, "weakness": {"cwe_ids": ["CWE-312"], "cwe_primary": "CWE-312", "cwe_family": null, "cwe_names": {"CWE-312": "Cleartext Storage of Sensitive Information"}}, "software": {"vendors": null, "products": null, "cpe_uris": "cpe:2.3:a:konflux:ci:*:*:*:*:*:*:*:*,cpe:2.3:a:konflux:ci:*:*:*:*:*:*:*:*,cpe:2.3:a:konflux:ci:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://access.redhat.com/security/cve/CVE-2026-114217", "https://bugzilla.redhat.com/show_bug.cgi?id=2564218"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-114217", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-114217"}, "item_id": "CVE-2026-114217", "_relevance": {"keep": true, "score": 0.7, "primary_pir": "3", "reason": "Plaintext storage of GitHub access tokens in konflux-ci CI runners, affecting credential management in widely deployed platform software.", "fail_open": false}}
{"id": "CVE-2026-119977", "identity": {"title": "CVE-2026-119977", "published": "2026-10-31 05:33:07", "modified": "2026-10-31 06:16:34", "description": "WordPress Core is vulnerable to Remote Code Execution in versions 4.7 through 7.1.3. This is due to predictable, web-accessible staging paths used during full-package core upgrades. This makes it possible for unauthenticated attackers to execute code on the server during the upgrade window."}, "cvss": {"base_score": 8.1, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "HIGH", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": 0.006, "percentile": 0.48715, "date": "2026-10-31"}, "exploitation": {"wild_exploited": true, "wild_exploited_sources": ["vulncheck_kev", "vulners"], "wild_exploited_by_vulncheck_kev": true, "vulncheck_kev_date_added": "2026-10-30", "vulncheck_evidence_count": 1, "vulncheck_exploit_repo_count": 0, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://core.trac.wordpress.org/browser/tags/7.1.3/src/wp-admin/setup-config.php#L282"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-367"], "cwe_primary": "CWE-367", "cwe_family": null, "cwe_names": {"CWE-367": "Time-of-check Time-of-use (TOCTOU) Race Condition"}}, "software": {"vendors": "WordPress Foundation", "products": "WordPress", "cpe_uris": "cpe:2.3:a:wordpress:wordpress:*:*:*:*:*:*:*:*,cpe:2.3:a:wordpress:wordpress:*:*:*:*:*:*:*:*