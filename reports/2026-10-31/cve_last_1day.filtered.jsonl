n/detail?vulnId=CVE-2026-119977"}, "item_id": "CVE-2026-119977", "_relevance": {"keep": true, "score": 0.65, "primary_pir": "3", "reason": "WordPress Core RCE during upgrades affects widely deployed platform software, kept for recall bias despite CMS context.", "fail_open": false}}
{"id": "CVE-2026-116755", "identity": {"title": "CVE-2026-116755", "published": "2026-10-31 01:56:35", "modified": "2026-10-31 02:17:33", "description": "Improper Neutralization of Special Elements used in a Command ('Command Injection') in the Orchestrator component of SoftIron HyperCloud allows an authenticated user with access to the management plane to execute arbitrary operating system commands on hypervisor hosts as the privileged orchestration user. Attacker-controlled virtual machine template content (for example, the VM DESCRIPTION field) is delivered to hosts through a shell here-document whose terminator is not quoted, so shell expansion and here-document terminator injection are performed on that content during virtual machine lifecycle operations such as deploy, migrate, and network setup. Exploitation requires valid credentials, access to the management plane (owning a virtual machine alone is not sufficient), and a lifecycle operation that reaches the affected host. This issue affects the Orchestrator component of SoftIron HyperCloud from 1.0 through 2.6.17 and is fixed in 2.6.18."}, "cvss": {"base_score": 7.4, "severity": "HIGH", "attack_vector": "ADJACENT", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "REQUIRED", "scope": "UNCHANGED", "confidentiality_impact": "HIGH", "integrity_impact": "HIGH", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": 0.00929, "percentile": 0.60581, "date": "2026-10-31"}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://advisories.softiron.cloud/"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "ADJACENT", "privileges_required": "LOW", "user_interaction": "REQUIRED", "summary": "adjacent, privileges: LOW, user interaction: REQUIRED"}, "weakness": {"cwe_ids": ["CWE-78"], "cwe_primary": "CWE-78", "cwe_family": "Command Injection", "cwe_names": {"CWE-78": "Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"}}, "software": {"vendors": "SoftIron", "products": "HyperCloud", "cpe_uris": null, "software_map": []}, "references": ["https://advisories.softiron.cloud/"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-116755", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-116755"}, "item_id": "CVE-2026-116755", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "3", "reason": "Command injection in SoftIron HyperCloud hypervisor management plane, enterprise virtualization platform with broad infrastructure relevance.", "fail_open": false}}
