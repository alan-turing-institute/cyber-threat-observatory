{"id": "CVE-2026-120135", "identity": {"title": "CVE-2026-120135", "published": "2026-10-31 20:33:00", "modified": "2026-10-31 21:16:53", "description": "Uncontrolled Recursion vulnerability in Apache Thrift Java bindings.\n\n\n\nThis issue affects Apache Thrift: before 0.24.0.\n\n\n\nUsers are recommended to upgrade to version 0.24.0, which fixes the issue."}, "cvss": {"base_score": 8.2, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": null, "confidentiality_impact": "NONE", "integrity_impact": "NONE", "availability_impact": "HIGH", "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_sources": [], "wild_exploited_by_vulncheck_kev": false, "vulncheck_kev_date_added": null, "vulncheck_evidence_count": null, "vulncheck_exploit_repo_count": null, "wild_exploited_by_cisa_kev": false, "cisa_kev_date_added": null, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://lists.apache.org/thread/7v3jhgwfbmhx42424phydlnzb109g8b9"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-674"], "cwe_primary": "CWE-674", "cwe_family": null, "cwe_names": {"CWE-674": "Uncontrolled Recursion"}}, "software": {"vendors": "Apache Software Foundation", "products": "Apache Thrift", "cpe_uris": "cpe:2.3:a:apache:thrift:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://lists.apache.org/thread/7v3jhgwfbmhx42424phydlnzb109g8b9", "https://lists.apache.org/thread/2zzkm3mfhfg79ohjo37pg1gms5nto588", "http://www.openwall.com/lists/oss-security/20