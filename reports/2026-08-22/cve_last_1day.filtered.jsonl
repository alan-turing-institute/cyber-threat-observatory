{"id": "CVE-2026-62388", "identity": {"title": "CVE-2026-62388", "published": "2026-08-22 14:12:38", "modified": "2026-08-22 15:16:18", "description": "NLTK versions before 3.10.0 default to ENFORCE=False in pathsec.py, causing all security validation functions to emit warnings instead of raising exceptions. Attackers can bypass path traversal and pickle deserialization protections by exploiting the disabled security controls that are only active when manually enabled."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nltk/nltk/security/advisories/GHSA-p3m8-78j2-g5p3"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-1188"], "cwe_primary": "CWE-1188", "cwe_family": null, "cwe_names": {"CWE-1188": "Initialization of a Resource with an Insecure Default"}}, "software": {"vendors": "nltk", "products": "nltk", "cpe_uris": "cpe:2.3:a:nltk:nltk:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/nltk/nltk/security/advisories/GHSA-p3m8-78j2-g5p3", "https://www.vulncheck.com/advisories/nltk-before-insecure-default-configuration-pathsec"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-62388", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-62388"}, "i