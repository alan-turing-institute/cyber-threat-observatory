{"id": "CVE-2026-70626", "identity": {"title": "CVE-2026-70626", "published": "2026-08-22 14:12:44", "modified": "2026-08-22 15:16:21", "description": "NLTK versions before 3.9.4 contain a symlink escape vulnerability in CorpusReader.open() that allows local attackers to read arbitrary files outside the corpus root. The vulnerability exists because path validation is lexical and does not account for symlink resolution, enabling attackers to place symlinks inside the corpus root to access files outside the intended boundary."}, "cvss": {"base_score": 8.6, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nltk/nltk/security/advisories/GHSA-r6gq-whwq-mvg9"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-59"], "cwe_primary": "CWE-59", "cwe_family": null, "cwe_names": {"CWE-59": "Improper Link Resolution Before File Access ('Link Following')"}}, "software": {"vendors": "nltk", "products": "nltk", "cpe_uris": "cpe:2.3:a:nltk:nltk:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/nltk-before-symlink-escape-via-corpusreader", "https://github.com/nltk/nltk/security/advisories/GHSA-r6gq-whwq-mvg9"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-70626", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-70626"}, "item_id": "CVE-2026-70626", "_relevance": {"keep": true, "score": 0.65, "primary_pir": "6", "reason": "Widely deployed Python NLP library with broad transitive reach vulnerable to local file read via symlink escape.", "fail_open": false}}
{"id": "CVE-2026-66393", "identity": {"title": "CVE-2026-66393", "published": "2026-08-22 14:12:42", "modified": "2026-08-22 15:16:19", "description": "NLTK versions before 3.9.4 contain an unbounded recursion vulnerability in JSONTaggedDecoder.decode_obj() that allows attackers to cause denial of service by supplying deeply nested JSON structures. Attackers can craft JSON payloads exceeding the recursion limit to trigger an unhandled RecursionError that crashes the Python process."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nltk/nltk/security/advisories/GHSA-rf74-v2fm-23pw"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-674"], "cwe_primary": "CWE-674", "cwe_family": null, "cwe_names": {"CWE-674": "Uncontrolled Recursion"}}, "software": {"vendors": "nltk", "products": "nltk", "cpe_uris": "cpe:2.3:a:nltk:nltk:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/nltk-before-denial-of-service-via-jsontaggeddecoder", "https://github.com/nltk/nltk/security/advisories/GHSA-rf74-v2fm-23pw"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-66393", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-66393"}, "item_id": "CVE-2026-66393", "_relevance": {"keep": true, "score": 0.6, "primary_pir": "6", "reason": "Widely deployed Python NLP library with broad transitive reach vulnerable to remote DoS via crafted JSON payloads.", "fail_open": false}}
{"id": "CVE-2026-65915", "identity": {"title": "CVE-2026-65915", "published": "2026-08-22 14:12:41", "modified": "2026-08-22 15:16:19", "description": "NLTK versions before 3.10.0 contain a logic bug in FileSystemPathPointer.open() where the sandbox validation check compares a normalized path against itself, making the security check permanently inert. Attackers can pass file:// URLs to nltk.data.load() to read arbitrary files accessible to the process user, including credentials and configuration files."}, "cvss": {"base_score": 7.1, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nltk/nltk/security/advisories/GHSA-72r2-7mfr-5xr9"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-284"], "cwe_primary": "CWE-284", "cwe_family": "AuthZ/Access Control", "cwe_names": {"CWE-284": "Improper Access Control"}}, "software": {"vendors": "nltk", "products": "nltk", "cpe_uris": "cpe:2.3:a:nltk:nltk:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/nltk-before-arbitrary-file-read-via-filesystempathpointer", "https://github.com/nltk/nltk/security/advisories/GHSA-72r2-7mfr-5xr9"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-65915", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-65915"}, "item_id": "CVE-2026-65915", "_relevance": {"keep": true, "score": 0.6, "primary_pir": "3", "reason": "Widely deployed Python NLP library with sandbox bypass enabling arbitrary file read, fitting platform software supply chain scope.", "fail_open": false}}
{"id": "CVE-2026-63312", "identity": {"title": "CVE-2026-63312", "published": "2026-08-22 14:12:40", "modified": "2026-08-22 15:16:19", "description": "NLTK before 3.10.0 contains an arbitrary local file read vulnerability in StreamBackedCorpusView that bypasses pathsec.ENFORCE by calling builtins.open() directly instead of pathsec.open(). Attackers who control the fileid argument can read arbitrary local files regardless of the ENFORCE setting, including sensitive system files and application credentials."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nltk/nltk/security/advisories/GHSA-x5ph-mj9p-rfr8"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-22"], "cwe_primary": "CWE-22", "cwe_family": "Path Traversal", "cwe_names": {"CWE-22": "Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"}}, "software": {"vendors": "nltk", "products": "nltk", "cpe_uris": "cpe:2.3:a:nltk:nltk:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/nltk/nltk/security/advisories/GHSA-x5ph-mj9p-rfr8", "https://www.vulncheck.com/advisories/nltk-streambackedcorpusview-bypasses-pathsec-enforce-arbitrary-file-read"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-63312", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-63312"}, "item_id": "CVE-2026-63312", "_relevance": {"keep": true, "score": 0.6, "primary_pir": "3", "reason": "Broadly used Python library vulnerability enabling arbitrary local file read, relevant to platform software supply chain.", "fail_open": false}}
{"id": "CVE-2026-63310", "identity": {"title": "CVE-2026-63310", "published": "2026-08-22 14:12:39", "modified": "2026-08-22 15:16:19", "description": "NLTK before 3.9.3 fails to verify file integrity after downloading packages and before extraction in the downloader module. Attackers can perform man-in-the-middle attacks or DNS poisoning to inject malicious package contents that are extracted without validation."}, "cvss": {"base_score": 9.3, "severity": "CRITICAL", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "Critical"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nltk/nltk/security/advisories/GHSA-5wp5-5229-5g6q"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-494"], "cwe_primary": "CWE-494", "cwe_family": null, "cwe_names": {"CWE-494": "Download of Code Without Integrity Check"}}, "software": {"vendors": "nltk", "products": "nltk", "cpe_uris": "cpe:2.3:a:nltk:nltk:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/nltk-before-missing-post-download-integrity-verification", "https://github.com/nltk/nltk/security/advisories/GHSA-5wp5-5229-5g6q"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-63310", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-63310"}, "item_id": "CVE-2026-63310", "_relevance": {"keep": true, "sc