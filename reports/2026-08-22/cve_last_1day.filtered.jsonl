{"id": "CVE-2026-62384", "identity": {"title": "CVE-2026-62384", "published": "2026-08-22 14:12:37", "modified": "2026-08-22 15:16:18", "description": "NLTK versions before 3.10.2 contain a symlink-based sandbox bypass in FramenetCorpusReader that allows attackers to read arbitrary XML files outside the corpus root. Attackers can place symlinks with names containing no path separators inside the corpus subdirectory, which pass the path validation guard and are resolved to files outside the intended corpus root when accessed via frame_by_name(), _lu_file(), or doc() methods."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nltk/nltk/security/advisories/GHSA-f833-7jw8-xwrv"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-22"], "cwe_primary": "CWE-22", "cwe_family": "Path Traversal", "cwe_names": {"CWE-22": "Improper Limitation of a Pathname to a Restricted Directory ('Path Traversal')"}}, "software": {"vendors": "nltk", "products": "nltk", "cpe_uris": "cpe:2.3:a:nltk:nltk:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/nltk/nltk/security/advisories/GHSA-f833-7jw8-xwrv", "https://www.vulncheck.com/advisories/nltk-framenetcorpusreader-symlink-sandbox-bypass-before"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-62384", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-62384"}, "item_id": "CVE-2026-62384", "_relevance": {"keep": true, "score": 0.6, "primary_pir": "3", "reason": "Symlink-based sandbox bypass in widely used Python NLP library allowing arbitrary file read.", "fail_open": false}}
{"id": "CVE-2026-62385", "identity": {"title": "CVE-2026-62385", "published": "2026-08-22 14:12:37", "modified": "2026-08-22 15:16:18", "description": "NLTK versions before 3.10.0 contain a path traversal vulnerability in FramenetCorpusReader and NKJPCorpusReader that allows attackers to parse XML files outside the corpus root by supplying unsafe selectors or poisoned index state. Attackers can exploit frame_by_name, doc, lu, and header methods with crafted parameters to read arbitrary XML files accessible to the application."}, "cvss": {"base_score": 8.2, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nltk/nltk/security/advisories/GHSA-568f-pv23-39p4"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-73"], "cwe_primary": "CWE-73", "cwe_family": null, "cwe_names": {"CWE-73": "External Control of File Name or Path"}}, "software": {"vendors": "nltk", "products": "nltk", "cpe_uris": "cpe:2.3:a:nltk:nltk:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://www.vulncheck.com/advisories/nltk-path-traversal-via-framenet-and-nkjp-readers", "https://github.com/nltk/nltk/security/advisories/GHSA-568f-pv23-39p4"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-62385", "nvd_href": "https://web.nvd.nist.gov/view/vuln