{"id": "CVE-2026-78122", "identity": {"title": "CVE-2026-78122", "published": "2026-08-22 23:06:32", "modified": "2026-08-22 23:16:22", "description": "docker-socket-proxy fails to properly gate read endpoints in the /containers Docker API namespace when the CONTAINERS environment variable is set. Attackers can use GET requests to /containers/{id}/archive, /containers/{id}/export, /containers/{id}/logs, and /containers/{id}/top to read arbitrary files and download entire container filesystems as tar archives."}, "cvss": {"base_score": 8.3, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/Tecnativa/docker-socket-proxy/blob/v0.5.0/haproxy.cfg#L49-L61"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-1220"], "cwe_primary": "CWE-1220", "cwe_family": null, "cwe_names": {"CWE-1220": "Insufficient Granularity of Access Control"}}, "software": {"vendors": "Tecnativa", "products": "docker-socket-proxy", "cpe_uris": "cpe:2.3:a:tecnativa:docker-socket-proxy:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/Tecnativa/docker-socket-proxy/blob/v0.5.0/haproxy.cfg#L49-L61", "https://www.vulncheck.com/advisories/docker-socket-proxy-through-insufficient-access-control-granularity-exposes-container-filesystems", "https://github.com/Tecnativa/docker-