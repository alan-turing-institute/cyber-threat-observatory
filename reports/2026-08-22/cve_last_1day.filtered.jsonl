{"id": "CVE-2026-71513", "identity": {"title": "CVE-2026-71513", "published": "2026-08-22 13:34:07", "modified": "2026-08-22 14:16:33", "description": "NLTK before 3.10.3 contains a remote code execution vulnerability in AllowlistUnpickler that validates only the pickle module string and not the global name, allowing attackers to resolve dotted names by attribute traversal to callables outside the allowlisted namespace. Attackers can craft untrusted transition-parser models that execute arbitrary commands when TransitionParser.parse loads the model through allowlisted_pickle_load."}, "cvss": {"base_score": 8.8, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/nltk/nltk"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-502"], "cwe_primary": "CWE-502", "cwe_family": null, "cwe_names": {"CWE-502": "Deserialization of Untrusted Data"}}, "software": {"vendors": "nltk", "products": "nltk", "cpe_uris": "cpe:2.3:a:nltk:nltk:*:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/nltk/nltk", "https://github.com/nltk/nltk/blob/v3.10.2/nltk/picklesec.py#L119-L124", "https://github.com/nltk/nltk/commit/c3e37113742a1ebeeb4f2ca58941f320f98805ea", "https://www.vulncheck.com/advisories/nltk-through-remote-code-execution-via-allowlistunpickler-dotted-name-bypass"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-71513", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-71513"}, "item_id": "CVE-2026-71513", "_relevance": {"keep": true, "score": 0.7, "primary_pir": "3", "reason": "Remote code execution via pickle deserialization bypass in widely deployed Python library, significant supply chain risk.", "fail_open": false}}
{"id": "CVE-2026-62243", "identity": {"title": "CVE-2026-62243", "published": "2026-08-22 12:26:43", "modified": "2026-08-22 13:16:39", "description": "Netty (io.netty:netty-handler) versions from 4.2.0.Final through 4.2.16.Final and versions through 4.1.136.Final disable TLS hostname verification on the SslProvider.OPENSSL client path when a plain (non-extended) X509TrustManager is used and Unsafe-based trust-manager wrapping is unavailable (Java 25+). In this configuration the OpenSSL client does not perform hostname verification, allowing a man-in-the-middle attacker to present a certificate issued for a different hostname that is accepted without validation. Fixed in 4.2.17.Final and 4.1.137.Final."}, "cvss": {"base_score": 8.7, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/netty/netty/security/advisories/GHSA-p85m-gvr3-788c"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-297"], "cwe_primary": "CWE-297", "cwe_family": null, "cwe_names": {"CWE-297": "Improper Validation of Certificate with Host Mismatch"}}, "software": {"vendors": "netty,netty", "products": "netty,netty", "cpe_uris": "cpe:2.3:a:netty:netty:*:*:*:*:*:*:*:*,cpe:2.3:a:netty:netty:*:*:*:*:*:*:*:*", "software_map": [{"key": "netty:netty", "vendor": "netty", "product": "netty", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": null, "surface": null, "tags": null}]}, "references": ["https://github.com/netty/netty/security/advisories/GHSA-p85m-gvr3-788c", "https://www.vulncheck.com/advisories/netty-through-tls-hostname-verification-bypass"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-62243", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-62243"}, "item_id": "CVE-2026-62243", "_relevance": {"keep": true, "score": 0.7, "primary_pir": "3", "reason": "TLS hostname verification bypass in Netty, a widely deployed enterprise Java networking library with broad transitive reach.", "fail_open": false}}
{"id": "CVE-2026-57998", "identity": {"title": "CVE-2026-57998", "published": "2026-08-22 12:26:30", "modified": "2026-08-22 13:16:38", "description": "better-npm-audit through 3.11.0, and the 4.0.0-rc.2 prerelease, builds its npm audit command by interpolating the user-supplied --registry option into a command string in src/handlers/handleInput.ts without validation or quoting, then passes that string to child_process.exec() in index.ts, which spawns a shell. A registry value containing shell metacharacters such as a semicolon, pipe, or command substitution executes arbitrary operating system commands with the privileges of the process running the audit."}, "cvss": {"base_score": 8.5, "severity": "HIGH", "attack_vector": null, "attack_complexity": null, "privileges_required": null, "user_interaction": null, "scope": null, "confidentiality_impact": null, "integrity_impact": null, "availability_impact": null, "band": "High"}, "epss": {"score": null, "percentile": null, "date": null}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/jeemok/better-npm-audit/blob/fd99a0f41ff4342b8a0a6fdbe5a17261de3d0544/index.ts#L34"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": null, "privileges_required": null, "user_interaction": null, "summary": "Unknown"}, "weakness": {"cwe_ids": ["CWE-78"], "cwe_primary": "CWE-78", "cwe_family": "Command Injection", "cwe_names": {"CWE-78": "Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')"}}, "software": {"vendors": "jeemok", "products": "better-npm-audit", "cpe_uris": "cpe:2.3:a:jeemok:better-npm-audit:*:*:*:*:*:*:*:*,cpe:2.3:a:jeemok:better-npm-audit:4.0.0-rc.2:*:*:*:*:*:*:*", "software_map": []}, "references": ["https://github.com/jeemok/better-npm-audit/blob/fd99a0f41ff4342b8a0a6fdbe5a17261de3d0544/index.ts#L34", "https://www.vulncheck.com/advisories/better-npm-audit-os-command-injection-via-registry-flag", "https://github.com/jeemok/better-npm-audit/blob/fd99a0f41ff4342b8a0a6fdbe5a17261de3d0544/src/handlers/handleInput.ts#L30-L37", "https://github.com/jeemok/better-npm-audit/issues/119", "https://github.com/jeemok/better-npm-audit", "https://github.com/jeemok/better-npm-audit/pull/120"], "sources": {"vulners_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-57998", "nvd_href": "https://web.nvd.nist.gov/view/vuln/detail?vulnId=CVE-2026-57998"}, "item_id": "CVE-2026-57998", "_relevance": {"keep": true, "score": 0.75, "primary_pir": "3", "reason": "Command injection in widely used npm security auditing tool with broad transitive reach in developer and CI/CD environments.", "fail_open": false}}
