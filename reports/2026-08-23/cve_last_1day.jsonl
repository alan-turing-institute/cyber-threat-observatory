{"id": "CVE-2026-78063", "identity": {"title": "CVE-2026-78063", "published": "2026-08-23 04:30:10", "modified": "2026-08-23 05:16:53", "description": "A security flaw has been discovered in Tenda CH22 1.0.0.1. The impacted element is the function formeditFileName of the file /goform/editFileName. The manipulation of the argument editNameMit results in command injection. The attack can be launched remotely. The exploit has been released to the public and may be used for attacks."}, "cvss": {"base_score": 7.4, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "LOW", "user_interaction": "NONE", "scope": "CHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": 0.02747, "percentile": 0.85014, "date": "2026-08-24"}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": false, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://vuldb.com/submit/881838"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "LOW", "user_interaction": "NONE", "summary": "network, privileges: LOW, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-74", "CWE-77"], "cwe_primary": "CWE-74", "cwe_family": "Injection", "cwe_names": {"CWE-74": "Improper Neutralization of Special Elements in Output Used by a Downstream Component ('Injection')", "CWE-77": "Improper Neutralization of Special Elements used in a Command ('Command Injection')"}}, "software": {"vendors": "Tenda", "products": "CH22", "cpe_uris": "cpe:2.3:h:tenda:ch22:1.0.0.1:*:*:*:*:*:*:*", "software_map": [{"key": "tenda:ch22", "vendor": "Tenda", "product": "CH22", "source": "cna_vendor_product", "sample_cpe": null, "category": null, "platform": nul