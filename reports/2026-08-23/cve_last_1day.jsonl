{"id": "CVE-2026-78062", "identity": {"title": "CVE-2026-78062", "published": "2026-08-23 04:15:10", "modified": "2026-08-23 05:16:52", "description": "A vulnerability was identified in vas3k TaxHacker up to 0.8.2. The affected element is the function envSchema.parse of the file lib/config.ts of the component JWT Secret Handler. The manipulation of the argument BETTER_AUTH_SECRET leads to hard-coded credentials. The attack can be initiated remotely. The project was informed of the problem early through an issue report but has not responded yet."}, "cvss": {"base_score": 7.3, "severity": "HIGH", "attack_vector": "NETWORK", "attack_complexity": "LOW", "privileges_required": "NONE", "user_interaction": "NONE", "scope": "UNCHANGED", "confidentiality_impact": "LOW", "integrity_impact": "LOW", "availability_impact": "LOW", "band": "High"}, "epss": {"score": 0.00495, "percentile": 0.40457, "date": "2026-08-24"}, "exploitation": {"wild_exploited": false, "wild_exploited_by_cisa_kev": false, "wild_exploited_by_cisa": false, "has_exploit_bulletin": false, "has_exploit_reference": true, "has_public_exploit_provider": false, "has_github_exploit": false, "top_reference_url": "https://github.com/vas3k/TaxHacker/"}, "ssvc": {"exploitation": null, "automatable": null, "technical_impact": null, "poc": false}, "barriers": {"attack_vector": "NETWORK", "privileges_required": "NONE", "user_interaction": "NONE", "summary": "network, privileges: NONE, user interaction: NONE"}, "weakness": {"cwe_ids": ["CWE-259", "CWE-798"], "cwe_primary": "CWE-259", "cwe_family": null, "cwe_names": {"CWE-259": "Use of Hard-coded Password", "CWE-798": "Use of Hard-coded Credentials"}}, "software": {"vendors": "vas3k", "products": "TaxHacker", "cpe_uris": null, "software_map": []}, "references": ["https://github.com/vas3k/TaxHacker/", "https://github.com/vas3k/TaxHacker/issues/147", "https://vuldb.com/vuln/394302", "https://vuldb.com/vuln/394302/cti", "https://vuldb.com/submit/881826", "https://vuldb.com/cv